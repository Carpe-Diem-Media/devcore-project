#!/usr/bin/env bash
set -euo pipefail
set +x
umask 077

VERSION="1.2.0"
PROGRAM="devcore-project"

CENTRAL_DIR="${DEVCORE_CONFIG_DIR:-$HOME/.config/dev-core}"
if [[ -n "${DEVCORE_MUTATION_LOCK_FDS:-}" ]]; then
  CENTRAL_SECRETS="${DEVCORE_MUTATION_SECRETS_PATH:-${DEVCORE_SECRETS_FILE:-$CENTRAL_DIR/project-db.env}}"
  GLOBAL_CONF="${DEVCORE_MUTATION_GLOBAL_CONF_PATH:-${DEVCORE_GLOBAL_CONF:-$CENTRAL_DIR/dev-core.conf}}"
else
  CENTRAL_SECRETS="${DEVCORE_SECRETS_FILE:-$CENTRAL_DIR/project-db.env}"
  GLOBAL_CONF="${DEVCORE_GLOBAL_CONF:-$CENTRAL_DIR/dev-core.conf}"
fi
PROJECT_CONF="${DEVCORE_PROJECT_CONF:-.devcore/project.conf}"

log()  { printf '%s\n' "$*" >&2; }
pass() { printf 'PASS: %s\n' "$*"; }
warn() { printf 'WARN: %s\n' "$*" >&2; }
die()  { printf 'ERROR: %s\n' "$*" >&2; exit 1; }

usage() {
  cat <<'USAGE'
devcore-project v1.2.0

Reusable local-project bootstrap for the shared dev-core workstation stack.

Commands:
  install
      Create ~/.config/dev-core/dev-core.conf and project-db.env if absent.
      Does NOT create/start Docker services.

  init --project-key KEY --dev-role ROLE --dev-db DB --test-role ROLE --test-db DB [options]
      Create a repo-local .devcore skeleton. Tracked config contains no secrets.

      Options:
        --redis-prefix PREFIX          Default: project key
        --dev-secret-key KEY           Default: <PROJECT>_DEV_DB_PASSWORD
        --test-secret-key KEY          Default: <PROJECT>_TEST_DB_PASSWORD
        --test-createdb yes|no         Default: yes
        --use-redis yes|no             Default: yes
        --local-env-file PATH          Default: .env.local
        --force                        Replace existing .devcore skeleton

  slots manifest|enable|disable|status|acquire|run|release|retain|recover|verify
      Opt-in managed NewYou slots. See slots --help and docs/managed-slots.md.

  plan
      Show the non-secret resolved project contract and readiness checks.

  activate
      Idempotently:
        - create missing central DEV/TEST passwords;
        - provision/refresh project PostgreSQL roles and databases;
        - render ignored local env files from committed templates;
        - verify PostgreSQL and Redis connectivity/isolation.
      Never starts/stops/recreates dev-core.

  doctor
      Read-only DB authentication checks plus scoped Redis probe checks.
      Never prints passwords.

  render
      Re-render ignored local env files from current central secrets.

  rotate
      Rotate BOTH DEV and TEST DB passwords, synchronize PostgreSQL roles,
      re-render local env files, then run doctor. Values are never printed.

  run PROFILE -- COMMAND [ARGS...]
      Execute COMMAND with env files registered for PROFILE plus profile "all".
      Examples:
        devcore-project run dev -- mix phx.server
        devcore-project run test -- mix test
        devcore-project run all -- bash scripts/dev_local.sh doctor

Environment overrides:
  DEVCORE_CONFIG_DIR
  DEVCORE_SECRETS_FILE
  DEVCORE_GLOBAL_CONF
  DEVCORE_PROJECT_CONF
USAGE
}

need_cmd() {
  command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"
}

require_no_xtrace() {
  case "$-" in
    *x*) die "refusing to handle secrets while shell xtrace is enabled" ;;
  esac
}

kv_get() {
  local file="$1" key="$2" default="${3-}"
  [[ -f "$file" ]] || { printf '%s' "$default"; return 0; }
  local line k v
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "${line//[[:space:]]/}" ]] && continue
    [[ "$line" =~ ^[[:space:]]*# ]] && continue
    [[ "$line" == *"="* ]] || continue
    k="${line%%=*}"
    v="${line#*=}"
    k="${k#"${k%%[![:space:]]*}"}"
    k="${k%"${k##*[![:space:]]}"}"
    if [[ "$k" == "$key" ]]; then
      v="${v#"${v%%[![:space:]]*}"}"
      v="${v%"${v##*[![:space:]]}"}"
      printf '%s' "$v"
      return 0
    fi
  done < "$file"
  printf '%s' "$default"
}

kv_set_secret() {
  local file="$1" key="$2" value="$3"
  printf '%s' "$value" | python3 -c '
from pathlib import Path
import os, sys, tempfile
path=Path(sys.argv[1]).expanduser(); key=sys.argv[2]; value=sys.stdin.read()
path.parent.mkdir(parents=True, exist_ok=True)
lines=path.read_text().splitlines() if path.exists() else []
out=[]; replaced=False
for raw in lines:
    stripped=raw.lstrip()
    if not stripped.startswith("#") and "=" in raw and raw.split("=",1)[0].strip()==key:
        out.append(f"{key}={value}"); replaced=True
    else:
        out.append(raw)
if not replaced:
    out.append(f"{key}={value}")
fd,tmp=tempfile.mkstemp(prefix=f".{path.name}.", dir=str(path.parent), text=True)
try:
    with os.fdopen(fd,"w") as f:
        f.write("\n".join(out)+"\n")
        f.flush(); os.fsync(f.fileno())
    os.chmod(tmp,0o600)
    os.replace(tmp,path)
finally:
    if os.path.exists(tmp): os.unlink(tmp)
os.chmod(path,0o600)
' "$file" "$key"
}

generate_secret() {
  python3 -c 'import secrets; print(secrets.token_hex(32), end="")'
}

normalize_secret_key() {
  printf '%s' "$1" | tr '[:lower:]' '[:upper:]' | sed -E 's/[-.]/_/g; s/[^A-Z0-9_]/_/g; s/^([0-9])/_\1/'
}

validate_state_paths() {
  python3 -c '
import os, stat, sys
from pathlib import Path

def normalized_state_path(raw):
    path = Path(raw).expanduser()
    if not path.is_absolute():
        path = Path.cwd() / path
    if not path.name or path.name in (".", ".."):
        raise RuntimeError("central state file path must name a file")
    canonical = path.parent.resolve(strict=False) / path.name
    try:
        entry = canonical.lstat()
    except FileNotFoundError:
        entry = None
    if entry is not None and stat.S_ISLNK(entry.st_mode):
        raise RuntimeError(f"central state file must not be a symlink: {canonical}")
    return canonical

central = Path(sys.argv[1]).expanduser()
canonical_dir = Path(os.path.abspath(os.path.normpath(central)))
try:
    secrets = normalized_state_path(sys.argv[2])
    global_conf = normalized_state_path(sys.argv[3])
except (OSError, RuntimeError) as error:
    raise SystemExit(f"ERROR: {error}")
if secrets == global_conf:
    raise SystemExit("ERROR: DEVCORE_SECRETS_FILE and DEVCORE_GLOBAL_CONF must identify different files")

try:
    directory = canonical_dir.lstat()
except FileNotFoundError:
    directory = None
if directory is not None:
    if stat.S_ISLNK(directory.st_mode) or not stat.S_ISDIR(directory.st_mode):
        raise SystemExit("ERROR: central config path must be a real directory")
    if directory.st_uid != os.getuid() or stat.S_IMODE(directory.st_mode) != 0o700:
        raise SystemExit("ERROR: central config directory must be owned by this user with mode 0700")

for path in (secrets, global_conf):
    try:
        entry = path.lstat()
    except FileNotFoundError:
        continue
    if stat.S_ISLNK(entry.st_mode) or not stat.S_ISREG(entry.st_mode):
        raise SystemExit(f"ERROR: central state file must be a regular non-symlink file: {path}")
    if entry.st_uid != os.getuid() or stat.S_IMODE(entry.st_mode) != 0o600:
        raise SystemExit(f"ERROR: central state file must be owned by this user with mode 0600: {path}")
    if entry.st_nlink != 1:
        raise SystemExit(f"ERROR: central state file must not have additional hard links: {path}")
    flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0)
    try:
        fd = os.open(path, flags)
    except OSError as error:
        raise SystemExit(f"ERROR: cannot safely open central state file {path}: {error}")
    try:
        opened = os.fstat(fd)
        current = path.lstat()
        if (opened.st_dev, opened.st_ino) != (current.st_dev, current.st_ino):
            raise SystemExit(f"ERROR: central state file changed during validation: {path}")
    finally:
        os.close(fd)
' "$CENTRAL_DIR" "$CENTRAL_SECRETS" "$GLOBAL_CONF"
}

write_global_defaults() {
  mkdir -p "$CENTRAL_DIR"
  chmod 700 "$CENTRAL_DIR"
  python3 -c '
import os, stat, sys, tempfile
from pathlib import Path

global_conf = Path(sys.argv[1]).expanduser()
secrets = Path(sys.argv[2]).expanduser()
global_body = b"""# dev-core workstation endpoints. Non-secret.
PG_DEV_HOST=127.0.0.1
PG_DEV_PORT=55432
PG_TEST_HOST=127.0.0.1
PG_TEST_PORT=55433
REDIS_DEV_HOST=127.0.0.1
REDIS_DEV_PORT=56379
REDIS_TEST_HOST=127.0.0.1
REDIS_TEST_PORT=56380
PG_DEV_CONTAINER=dev-core-postgres-dev-1
PG_TEST_CONTAINER=dev-core-postgres-test-1
REDIS_DEV_CONTAINER=dev-core-redis-dev-1
REDIS_TEST_CONTAINER=dev-core-redis-test-1
PG_ADMIN_ROLE=devcore_admin
"""

def validate(path):
    try:
        entry = path.lstat()
    except FileNotFoundError:
        return False
    if stat.S_ISLNK(entry.st_mode) or not stat.S_ISREG(entry.st_mode):
        raise RuntimeError(f"central state file must be a regular non-symlink file: {path}")
    if entry.st_uid != os.getuid() or stat.S_IMODE(entry.st_mode) != 0o600:
        raise RuntimeError(f"central state file must be owned by this user with mode 0600: {path}")
    if entry.st_nlink != 1:
        raise RuntimeError(f"central state file must not have additional hard links: {path}")
    return True

def create_if_absent(path, body):
    path.parent.mkdir(parents=True, exist_ok=True)
    if validate(path):
        return
    fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=str(path.parent))
    try:
        with os.fdopen(fd, "wb") as stream:
            stream.write(body)
            stream.flush()
            os.fsync(stream.fileno())
        os.chmod(temporary, 0o600)
        try:
            os.link(temporary, path, follow_symlinks=False)
        except FileExistsError:
            if not validate(path):
                raise RuntimeError(f"central state file disappeared during initialization: {path}")
        directory_fd = os.open(path.parent, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)

create_if_absent(global_conf, global_body)
create_if_absent(secrets, b"")
' "$GLOBAL_CONF" "$CENTRAL_SECRETS"
}

load_global() {
  PG_DEV_HOST="$(kv_get "$GLOBAL_CONF" PG_DEV_HOST 127.0.0.1)"
  PG_DEV_PORT="$(kv_get "$GLOBAL_CONF" PG_DEV_PORT 55432)"
  PG_TEST_HOST="$(kv_get "$GLOBAL_CONF" PG_TEST_HOST 127.0.0.1)"
  PG_TEST_PORT="$(kv_get "$GLOBAL_CONF" PG_TEST_PORT 55433)"
  REDIS_DEV_HOST="$(kv_get "$GLOBAL_CONF" REDIS_DEV_HOST 127.0.0.1)"
  REDIS_DEV_PORT="$(kv_get "$GLOBAL_CONF" REDIS_DEV_PORT 56379)"
  REDIS_TEST_HOST="$(kv_get "$GLOBAL_CONF" REDIS_TEST_HOST 127.0.0.1)"
  REDIS_TEST_PORT="$(kv_get "$GLOBAL_CONF" REDIS_TEST_PORT 56380)"
  PG_DEV_CONTAINER="$(kv_get "$GLOBAL_CONF" PG_DEV_CONTAINER dev-core-postgres-dev-1)"
  PG_TEST_CONTAINER="$(kv_get "$GLOBAL_CONF" PG_TEST_CONTAINER dev-core-postgres-test-1)"
  REDIS_DEV_CONTAINER="$(kv_get "$GLOBAL_CONF" REDIS_DEV_CONTAINER dev-core-redis-dev-1)"
  REDIS_TEST_CONTAINER="$(kv_get "$GLOBAL_CONF" REDIS_TEST_CONTAINER dev-core-redis-test-1)"
  PG_ADMIN_ROLE="$(kv_get "$GLOBAL_CONF" PG_ADMIN_ROLE devcore_admin)"
}

load_project() {
  [[ -f "$PROJECT_CONF" ]] || die "missing $PROJECT_CONF; run '$PROGRAM init ...' or add the repo contract"
  PROJECT_KEY="$(kv_get "$PROJECT_CONF" PROJECT_KEY)"
  DEV_DB_ROLE="$(kv_get "$PROJECT_CONF" DEV_DB_ROLE)"
  DEV_DB_NAME="$(kv_get "$PROJECT_CONF" DEV_DB_NAME)"
  TEST_DB_ROLE="$(kv_get "$PROJECT_CONF" TEST_DB_ROLE)"
  TEST_DB_NAME="$(kv_get "$PROJECT_CONF" TEST_DB_NAME)"
  DEV_SECRET_KEY="$(kv_get "$PROJECT_CONF" DEV_SECRET_KEY)"
  TEST_SECRET_KEY="$(kv_get "$PROJECT_CONF" TEST_SECRET_KEY)"
  TEST_ROLE_CREATEDB="$(kv_get "$PROJECT_CONF" TEST_ROLE_CREATEDB yes)"
  USE_REDIS="$(kv_get "$PROJECT_CONF" USE_REDIS yes)"
  REDIS_PREFIX="$(kv_get "$PROJECT_CONF" REDIS_PREFIX "$PROJECT_KEY")"
  RENDER_MAP="$(kv_get "$PROJECT_CONF" RENDER_MAP .devcore/render-map.tsv)"
  SUPPLEMENTAL_SECRETS="$(kv_get "$PROJECT_CONF" SUPPLEMENTAL_SECRETS)"
  SLOT_POOL="$(kv_get "$PROJECT_CONF" SLOT_POOL)"
}

supplemental_map_configured() {
  [[ -n "${SUPPLEMENTAL_SECRETS:-}" ]]
}

for_each_supplemental_row() {
  local callback="$1"
  python3 -c '
from pathlib import Path
import sys
path=Path(sys.argv[1])
if not path.exists():
    raise SystemExit(f"missing supplemental secrets map: {path}")
seen=set()
for raw in path.read_text().splitlines():
    if not raw.strip() or raw.lstrip().startswith("#"):
        continue
    parts=raw.split("\t")
    if len(parts)!=3:
        raise SystemExit(
            "Invalid supplemental-secrets row (need PROFILE<TAB>ENV_VAR<TAB>SECRET_KEY): "
            + raw
        )
    profile,env_var,secret_key=[part.strip() for part in parts]
    key=(profile,env_var)
    if key in seen:
        raise SystemExit(
            f"duplicate supplemental binding for profile={profile} env_var={env_var}"
        )
    seen.add(key)
    print("\t".join([profile,env_var,secret_key]))
' "$SUPPLEMENTAL_SECRETS" | while IFS=$'\t' read -r profile env_var secret_key; do
    "$callback" "$profile" "$env_var" "$secret_key"
  done
}

validate_supplemental_env_var() {
  local env_var="$1"
  validate_secret_name "supplemental ENV_VAR" "$env_var"
  case "$env_var" in
    PROJECT_KEY|DEV_DB_HOST|DEV_DB_PORT|DEV_DB_ROLE|DEV_DB_NAME|DEV_DB_PASSWORD|\
TEST_DB_HOST|TEST_DB_PORT|TEST_DB_ROLE|TEST_DB_NAME|TEST_DB_PASSWORD|\
REDIS_DEV_HOST|REDIS_DEV_PORT|REDIS_TEST_HOST|REDIS_TEST_PORT|\
REDIS_DEV_NAMESPACE|REDIS_TEST_NAMESPACE_BASE)
      die "supplemental ENV_VAR cannot use reserved render token: $env_var"
      ;;
  esac
}

validate_supplemental_secret_key() {
  local secret_key="$1"
  validate_secret_name "supplemental SECRET_KEY" "$secret_key"
  if [[ "$secret_key" == "$DEV_SECRET_KEY" || "$secret_key" == "$TEST_SECRET_KEY" ]]; then
    die "supplemental SECRET_KEY cannot reuse owner secret key: $secret_key"
  fi
}

validate_supplemental_row() {
  local profile="$1" env_var="$2" secret_key="$3"
  validate_profile_value "supplemental" "$profile"
  validate_supplemental_env_var "$env_var"
  validate_supplemental_secret_key "$secret_key"
}

validate_supplemental_value() {
  local label="$1" value="$2"
  [[ -n "$value" ]] || die "$label is empty"
  [[ "$value" =~ ^[A-Za-z0-9._:/+=,@%_-]+$ ]] || \
    die "$label contains characters outside the portable supplemental literal/token alphabet"
}

supplemental_profile_applies() {
  local binding_profile="$1" active_profile="$2"
  if [[ "$active_profile" == "all" ]]; then
    [[ "$binding_profile" == "all" ]]
    return $?
  fi
  [[ "$binding_profile" == "$active_profile" || "$binding_profile" == "all" ]]
}

check_supplemental_ambiguity() {
  supplemental_map_configured || return 0
  python3 -c '
from pathlib import Path
import sys

def parse_rows(path):
    rows=[]
    seen=set()
    for raw in Path(path).read_text().splitlines():
        if not raw.strip() or raw.lstrip().startswith("#"):
            continue
        parts=raw.split("\t")
        if len(parts)!=3:
            raise SystemExit(
                "Invalid supplemental-secrets row (need PROFILE<TAB>ENV_VAR<TAB>SECRET_KEY): "
                + raw
            )
        binding_profile,env_var,secret_key=[part.strip() for part in parts]
        key=(binding_profile,env_var)
        if key in seen:
            raise SystemExit(
                f"duplicate supplemental binding for profile={binding_profile} env_var={env_var}"
            )
        seen.add(key)
        rows.append((binding_profile,env_var,secret_key))
    return rows

def applies(binding_profile, active_profile):
    if active_profile=="all":
        return binding_profile=="all"
    return binding_profile==active_profile or binding_profile=="all"

rows=parse_rows(sys.argv[1])
for active_profile in ("dev","test","all"):
    by_env={}
    for binding_profile,env_var,secret_key in rows:
        if not applies(binding_profile, active_profile):
            continue
        if env_var in by_env:
            raise SystemExit(
                f"ambiguous supplemental env_var {env_var} for profile {active_profile}"
            )
        by_env[env_var]=secret_key
' "$SUPPLEMENTAL_SECRETS"
}

check_supplemental_contract() {
  supplemental_map_configured || return 0
  [[ -f "$SUPPLEMENTAL_SECRETS" ]] || die "missing supplemental secrets map: $SUPPLEMENTAL_SECRETS"
  for_each_supplemental_row validate_supplemental_row
  check_supplemental_ambiguity
}

require_one_supplemental_secret() {
  local _profile="$1" _env_var="$2" secret_key="$3"
  local value
  value="$(kv_get "$CENTRAL_SECRETS" "$secret_key")"
  [[ -n "$value" ]] || die "missing $secret_key in $CENTRAL_SECRETS; supplemental secret must exist locally"
  validate_supplemental_value "supplemental secret $secret_key" "$value"
}

require_supplemental_if_applicable() {
  local binding_profile="$1" env_var="$2" secret_key="$3"
  supplemental_profile_applies "$binding_profile" "$_require_supplemental_active_profile" || return 0
  require_one_supplemental_secret "$binding_profile" "$env_var" "$secret_key"
}

require_supplemental_secrets_for_profile() {
  local active_profile="$1"
  supplemental_map_configured || return 0
  check_supplemental_contract
  _require_supplemental_active_profile="$active_profile"
  for_each_supplemental_row require_supplemental_if_applicable
}

require_supplemental_secrets() {
  supplemental_map_configured || return 0
  check_supplemental_contract
  for_each_supplemental_row require_one_supplemental_secret
}

preflight_operational_contract() {
  check_render_contract
  require_supplemental_secrets
}

validate_identifier() {
  local label="$1" value="$2"
  [[ "$value" =~ ^[a-z][a-z0-9_]{0,62}$ ]] || die "$label must match ^[a-z][a-z0-9_]{0,62}$ (got: $value)"
}

validate_profile_value() {
  local label="$1" profile="$2"
  case "$profile" in
    dev|test|all) ;;
    *) die "invalid $label profile: $profile (expected dev, test, or all)" ;;
  esac
}

validate_secret_name() {
  local label="$1" value="$2"
  [[ "$value" =~ ^[A-Z_][A-Z0-9_]*$ ]] || die "$label is not a valid central secret key: $value"
}

validate_secret_value() {
  local label="$1" value="$2"
  [[ "$value" =~ ^[A-Za-z0-9._~-]{20,}$ ]] || die "$label contains unsupported characters or is too short; rotate it with '$PROGRAM rotate'"
}

validate_project() {
  [[ "$PROJECT_KEY" =~ ^[a-z0-9][a-z0-9_-]*$ ]] || die "invalid PROJECT_KEY: $PROJECT_KEY"
  validate_identifier DEV_DB_ROLE "$DEV_DB_ROLE"
  validate_identifier DEV_DB_NAME "$DEV_DB_NAME"
  validate_identifier TEST_DB_ROLE "$TEST_DB_ROLE"
  validate_identifier TEST_DB_NAME "$TEST_DB_NAME"
  validate_secret_name DEV_SECRET_KEY "$DEV_SECRET_KEY"
  validate_secret_name TEST_SECRET_KEY "$TEST_SECRET_KEY"
  [[ "$TEST_ROLE_CREATEDB" == "yes" || "$TEST_ROLE_CREATEDB" == "no" ]] || die "TEST_ROLE_CREATEDB must be yes or no"
  [[ "$USE_REDIS" == "yes" || "$USE_REDIS" == "no" ]] || die "USE_REDIS must be yes or no"
  [[ "$REDIS_PREFIX" =~ ^[A-Za-z0-9][A-Za-z0-9:_-]*$ ]] || die "invalid REDIS_PREFIX: $REDIS_PREFIX"
  [[ -f "$RENDER_MAP" ]] || die "missing render map: $RENDER_MAP"
  check_supplemental_contract
}

ensure_ignored() {
  local target="$1"
  if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    git check-ignore -q -- "$target" || die "refusing to write secret-bearing file not ignored by git: $target"
  fi
}

for_each_render_row() {
  local callback="$1"
  python3 -c '
from pathlib import Path
import sys
p=Path(sys.argv[1])
for raw in p.read_text().splitlines():
    if not raw.strip() or raw.lstrip().startswith("#"):
        continue
    parts=raw.split("\t")
    if len(parts)<3:
        raise SystemExit(f"Invalid render-map row (need PROFILE<TAB>TEMPLATE<TAB>TARGET): {raw}")
    profile,template,target=parts[:3]
    purge=parts[3] if len(parts)>3 else ""
    print("\t".join([profile.strip(),template.strip(),target.strip(),purge.strip()]))
' "$RENDER_MAP" | while IFS=$'\t' read -r profile template target purge; do
    "$callback" "$profile" "$template" "$target" "$purge"
  done
}

validate_render_row() {
  local profile="$1" template="$2" target="$3" _purge="$4"
  validate_profile_value "render" "$profile"
  [[ -f "$template" ]] || die "missing env template: $template"
  ensure_ignored "$target"
}

check_render_contract() {
  for_each_render_row validate_render_row
}

container_running() {
  local name="$1"
  [[ "$(docker inspect -f '{{.State.Running}}' "$name" 2>/dev/null || true)" == "true" ]]
}

ensure_secret_pair() {
  local dev test
  dev="$(kv_get "$CENTRAL_SECRETS" "$DEV_SECRET_KEY")"
  test="$(kv_get "$CENTRAL_SECRETS" "$TEST_SECRET_KEY")"

  if [[ -z "$dev" ]]; then
    dev="$(generate_secret)"
    kv_set_secret "$CENTRAL_SECRETS" "$DEV_SECRET_KEY" "$dev"
    pass "created central DEV credential for $PROJECT_KEY"
  fi
  if [[ -z "$test" ]]; then
    test="$(generate_secret)"
    kv_set_secret "$CENTRAL_SECRETS" "$TEST_SECRET_KEY" "$test"
    pass "created central TEST credential for $PROJECT_KEY"
  fi

  validate_secret_value DEV_DB_PASSWORD "$dev"
  validate_secret_value TEST_DB_PASSWORD "$test"
}

require_secret_pair() {
  [[ -f "$CENTRAL_SECRETS" ]] || die "missing central secrets file: $CENTRAL_SECRETS; run '$PROGRAM activate'"
  local dev test
  dev="$(kv_get "$CENTRAL_SECRETS" "$DEV_SECRET_KEY")"
  test="$(kv_get "$CENTRAL_SECRETS" "$TEST_SECRET_KEY")"
  [[ -n "$dev" ]] || die "missing $DEV_SECRET_KEY in $CENTRAL_SECRETS; run '$PROGRAM activate'"
  [[ -n "$test" ]] || die "missing $TEST_SECRET_KEY in $CENTRAL_SECRETS; run '$PROGRAM activate'"
  validate_secret_value DEV_DB_PASSWORD "$dev"
  validate_secret_value TEST_DB_PASSWORD "$test"
}

provision_database() {
  local container="$1" role="$2" db="$3" password="$4" allow_createdb="$5"
  container_running "$container" || die "required PostgreSQL container is not running: $container"

  local create_flag="NOCREATEDB"
  [[ "$allow_createdb" == "yes" ]] && create_flag="CREATEDB"

  {
    printf "\\set app_pass '%s'\n" "$password"
    cat <<'SQL'
SELECT format('CREATE ROLE %I LOGIN', :'role')
WHERE NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = :'role')
\gexec

SELECT format(
  'ALTER ROLE %I LOGIN NOSUPERUSER NOCREATEROLE NOREPLICATION NOBYPASSRLS %s PASSWORD %L',
  :'role', :'create_flag', :'app_pass'
)
\gexec

SELECT format('CREATE DATABASE %I OWNER %I', :'db', :'role')
WHERE NOT EXISTS (SELECT 1 FROM pg_database WHERE datname = :'db')
\gexec
SQL
  } | docker exec -i "$container" \
      psql -X -q -v ON_ERROR_STOP=1 -U "$PG_ADMIN_ROLE" -d postgres \
      -v role="$role" -v db="$db" -v create_flag="$create_flag" >/dev/null

  local owner
  owner="$(
    docker exec -i "$container" psql -X -qAt -U "$PG_ADMIN_ROLE" -d postgres -v db="$db" <<'SQL'
SELECT pg_get_userbyid(datdba)
FROM pg_database
WHERE datname = :'db';
SQL
  )"
  [[ "$owner" == "$role" ]] || die "database $db exists but owner is '$owner', expected '$role'; refusing implicit adoption"
}

provision_all() {
  local dev test
  dev="$(kv_get "$CENTRAL_SECRETS" "$DEV_SECRET_KEY")"
  test="$(kv_get "$CENTRAL_SECRETS" "$TEST_SECRET_KEY")"
  validate_secret_value DEV_DB_PASSWORD "$dev"
  validate_secret_value TEST_DB_PASSWORD "$test"
  provision_database "$PG_DEV_CONTAINER" "$DEV_DB_ROLE" "$DEV_DB_NAME" "$dev" no
  pass "DEV PostgreSQL role/database ready: $DEV_DB_ROLE / $DEV_DB_NAME"
  provision_database "$PG_TEST_CONTAINER" "$TEST_DB_ROLE" "$TEST_DB_NAME" "$test" "$TEST_ROLE_CREATEDB"
  pass "TEST PostgreSQL role/database ready: $TEST_DB_ROLE / $TEST_DB_NAME"
}

render_target() {
  local action="$1" profile="$2" template="$3" target="$4" purge="$5"
  python3 -c '
from pathlib import Path
import os,re,sys,tempfile
action=sys.argv[1]
project_conf=Path(sys.argv[2]); global_conf=Path(sys.argv[3]); secret_file=Path(sys.argv[4])
template=Path(sys.argv[5]); target=Path(sys.argv[6]); purge_arg=sys.argv[7]
supplemental_map=sys.argv[8] if len(sys.argv)>8 else ""
render_profile=sys.argv[9] if len(sys.argv)>9 else ""

def parse(path):
    out={}
    if not path.exists(): return out
    for raw in path.read_text().splitlines():
        line=raw.strip()
        if not line or line.startswith("#") or "=" not in line: continue
        k,v=line.split("=",1); key=k.strip()
        if key not in out: out[key]=v.strip()
    return out
p=parse(project_conf); g=parse(global_conf); s=parse(secret_file)
values={
  "PROJECT_KEY": p["PROJECT_KEY"],
  "DEV_DB_HOST": g.get("PG_DEV_HOST","127.0.0.1"),
  "DEV_DB_PORT": g.get("PG_DEV_PORT","55432"),
  "DEV_DB_ROLE": p["DEV_DB_ROLE"],
  "DEV_DB_NAME": p["DEV_DB_NAME"],
  "DEV_DB_PASSWORD": s[p["DEV_SECRET_KEY"]],
  "TEST_DB_HOST": g.get("PG_TEST_HOST","127.0.0.1"),
  "TEST_DB_PORT": g.get("PG_TEST_PORT","55433"),
  "TEST_DB_ROLE": p["TEST_DB_ROLE"],
  "TEST_DB_NAME": p["TEST_DB_NAME"],
  "TEST_DB_PASSWORD": s[p["TEST_SECRET_KEY"]],
  "REDIS_DEV_HOST": g.get("REDIS_DEV_HOST","127.0.0.1"),
  "REDIS_DEV_PORT": g.get("REDIS_DEV_PORT","56379"),
  "REDIS_TEST_HOST": g.get("REDIS_TEST_HOST","127.0.0.1"),
  "REDIS_TEST_PORT": g.get("REDIS_TEST_PORT","56380"),
  "REDIS_DEV_NAMESPACE": p.get("REDIS_PREFIX",p["PROJECT_KEY"])+":dev",
  "REDIS_TEST_NAMESPACE_BASE": p.get("REDIS_PREFIX",p["PROJECT_KEY"])+":test",
}
if supplemental_map:
    rows=[]
    seen=set()
    for raw in Path(supplemental_map).read_text().splitlines():
        if not raw.strip() or raw.lstrip().startswith("#"):
            continue
        parts=raw.split("\t")
        if len(parts)!=3:
            raise SystemExit(
                "Invalid supplemental-secrets row (need PROFILE<TAB>ENV_VAR<TAB>SECRET_KEY): "
                + raw
            )
        binding_profile,env_var,secret_key=[part.strip() for part in parts]
        key=(binding_profile,env_var)
        if key in seen:
            raise SystemExit(
                f"duplicate supplemental binding for profile={binding_profile} env_var={env_var}"
            )
        seen.add(key)
        rows.append((binding_profile,env_var,secret_key))
    def applies(binding_profile, active_profile):
        if active_profile=="all":
            return binding_profile=="all"
        return binding_profile==active_profile or binding_profile=="all"
    by_env={}
    for binding_profile,env_var,secret_key in rows:
        if not applies(binding_profile, render_profile):
            continue
        if env_var in by_env:
            raise SystemExit(
                f"ambiguous supplemental env_var {env_var} for profile {render_profile}"
            )
        if secret_key not in s or not s[secret_key]:
            raise SystemExit(
                f"missing {secret_key} in {secret_file}; supplemental secret must exist locally"
            )
        by_env[env_var]=s[secret_key]
    values.update(by_env)
body=template.read_text()
for k,v in values.items(): body=body.replace("{{"+k+"}}",v)
left=sorted(set(re.findall(r"\{\{([A-Z0-9_]+)\}\}",body)))
if left: raise SystemExit("Unresolved template tokens: "+", ".join(left))
managed_start="# >>> DEVCORE MANAGED >>>"
managed_end="# <<< DEVCORE MANAGED <<<"
block=managed_start+"\n"+body.rstrip()+"\n"+managed_end
existing=target.read_text() if target.exists() else ""
# Remove prior managed block.
existing=re.sub(re.escape(managed_start)+r".*?"+re.escape(managed_end)+r"\n?","",existing,flags=re.S)
# Remove duplicate keys managed by this template plus explicitly purged legacy keys.
managed_keys=[]
for raw in body.splitlines():
    line=raw.strip()
    if line.startswith("export "): line=line[7:].lstrip()
    if line and not line.startswith("#") and "=" in line:
        managed_keys.append(line.split("=",1)[0].strip())
purge=[x.strip() for x in purge_arg.split(",") if x.strip()]
remove=set(managed_keys+purge)
kept=[]
for raw in existing.splitlines():
    probe=raw.strip()
    if probe.startswith("export "): probe=probe[7:].lstrip()
    if probe and not probe.startswith("#") and "=" in probe and probe.split("=",1)[0].strip() in remove:
        continue
    kept.append(raw)
expected_content="\n".join(kept).rstrip()
if expected_content: expected_content += "\n\n"
expected_content += block+"\n"
if action == "check":
    if not target.is_file():
        raise SystemExit(f"rendered local env missing: {target}")
    if target.read_text() != expected_content:
        raise SystemExit(f"rendered local env stale: {target}")
elif action == "write":
    target.parent.mkdir(parents=True,exist_ok=True)
    fd,tmp=tempfile.mkstemp(prefix=f".{target.name}.",dir=str(target.parent),text=True)
    try:
        with os.fdopen(fd,"w") as f:
            f.write(expected_content); f.flush(); os.fsync(f.fileno())
        os.chmod(tmp,0o600); os.replace(tmp,target)
    finally:
        if os.path.exists(tmp): os.unlink(tmp)
    os.chmod(target,0o600)
else:
    raise SystemExit("invalid render operation")
' "$action" "$PROJECT_CONF" "$GLOBAL_CONF" "$CENTRAL_SECRETS" "$template" "$target" "$purge" "${SUPPLEMENTAL_SECRETS:-}" "$profile"
}

render_one() {
  local profile="$1" template="$2" target="$3" purge="$4"
  ensure_ignored "$target"
  render_target write "$profile" "$template" "$target" "$purge"
  pass "rendered $target ($profile)"
}

render_all() {
  check_render_contract
  for_each_render_row render_one
}

tcp_check() {
  local label="$1" host="$2" port="$3"
  python3 -c '
import socket,sys
host=sys.argv[1]; port=int(sys.argv[2])
with socket.create_connection((host,port),timeout=2):
    pass
' "$host" "$port" || die "$label endpoint unavailable at $host:$port"
  pass "$label endpoint reachable: $host:$port"
}

db_doctor() {
  local label="$1" container="$2" role="$3" db="$4" secret_key="$5" host="$6" port="$7" allow_createdb="$8"
  container_running "$container" || die "$label PostgreSQL container unavailable: $container"
  tcp_check "$label PostgreSQL" "$host" "$port"
  local password result
  password="$(kv_get "$CENTRAL_SECRETS" "$secret_key")"
  validate_secret_value "$label password" "$password"
  local query="
SELECT current_user,
       current_database(),
       current_setting('server_version_num'),
       pg_get_userbyid(d.datdba),
       r.rolcanlogin,
       r.rolsuper,
       r.rolcreatedb,
       r.rolcreaterole,
       r.rolreplication,
       r.rolbypassrls,
       (SELECT count(*)
          FROM pg_auth_members AS m
         WHERE m.member = r.oid OR m.roleid = r.oid)
  FROM pg_roles AS r
  JOIN pg_database AS d ON d.datname = current_database()
 WHERE r.rolname = current_user;"
  if command -v psql >/dev/null 2>&1; then
    result="$(PGPASSWORD="$password" psql -X -qAt -h "$host" -p "$port" -U "$role" -d "$db" \
      -F '|' -c "$query")"
  else
    result="$(printf '%s\n' "$password" | docker exec -i "$container" \
      sh -c 'IFS= read -r PGPASSWORD || exit 1; export PGPASSWORD; exec psql "$@"' \
      devcore-psql -X -qAt -h 127.0.0.1 -U "$role" -d "$db" \
      -F '|' -c "$query")"
  fi
  local -a fields
  IFS='|' read -r -a fields <<< "$result"
  [[ "${#fields[@]}" -eq 11 && "${fields[2]}" =~ ^[0-9]+$ ]] || \
    die "$label PostgreSQL invariant query returned an unexpected result"
  local expected_createdb="f"
  [[ "$allow_createdb" == "yes" ]] && expected_createdb="t"
  [[ "${fields[0]}" == "$role" && "${fields[1]}" == "$db" && \
     "${fields[3]}" == "$role" && "${fields[4]}" == "t" && \
     "${fields[5]}" == "f" && "${fields[6]}" == "$expected_createdb" && \
     "${fields[7]}" == "f" && "${fields[8]}" == "f" && \
     "${fields[9]}" == "f" && "${fields[10]}" == "0" ]] || \
    die "$label PostgreSQL role, ownership, or membership invariant failed"
  pass "$label PostgreSQL authentication: $role / $db (server version ${fields[2]})"
}

redis_doctor() {
  local label="$1" container="$2" namespace="$3" host="$4" port="$5"
  container_running "$container" || die "$label Redis container unavailable: $container"
  tcp_check "$label Redis" "$host" "$port"
  local probe="${namespace}:__devcore_probe:$$"
  local ping set_result get_result
  if command -v redis-cli >/dev/null 2>&1; then
    ping="$(redis-cli -h "$host" -p "$port" --raw PING)"
    [[ "$ping" == "PONG" ]] || die "$label Redis PING failed"
    set_result="$(redis-cli -h "$host" -p "$port" --raw SET "$probe" "1" EX 15 NX)"
    [[ "$set_result" == "OK" ]] || die "$label Redis scoped probe SET failed"
    get_result="$(redis-cli -h "$host" -p "$port" --raw GET "$probe")"
    redis-cli -h "$host" -p "$port" --raw DEL "$probe" >/dev/null
  else
    ping="$(docker exec "$container" redis-cli --raw PING)"
    [[ "$ping" == "PONG" ]] || die "$label Redis PING failed"
    set_result="$(docker exec "$container" redis-cli --raw SET "$probe" "1" EX 15 NX)"
    [[ "$set_result" == "OK" ]] || die "$label Redis scoped probe SET failed"
    get_result="$(docker exec "$container" redis-cli --raw GET "$probe")"
    docker exec "$container" redis-cli --raw DEL "$probe" >/dev/null
  fi
  [[ "$get_result" == "1" ]] || die "$label Redis scoped probe GET failed"
  pass "$label Redis: PONG + scoped probe ($namespace:...)"
}

check_local_modes() {
  local profile="$1" template="$2" target="$3" purge="$4"
  [[ -f "$target" ]] || die "rendered local env missing: $target"
  local mode
  mode="$(stat -c '%a' "$target")"
  [[ "$mode" == "600" ]] || die "$target mode is $mode, expected 600"
  render_target check "$profile" "$template" "$target" "$purge"
}

doctor_all() {
  db_doctor DEV "$PG_DEV_CONTAINER" "$DEV_DB_ROLE" "$DEV_DB_NAME" "$DEV_SECRET_KEY" "$PG_DEV_HOST" "$PG_DEV_PORT" no
  db_doctor TEST "$PG_TEST_CONTAINER" "$TEST_DB_ROLE" "$TEST_DB_NAME" "$TEST_SECRET_KEY" "$PG_TEST_HOST" "$PG_TEST_PORT" "$TEST_ROLE_CREATEDB"
  if [[ "$USE_REDIS" == "yes" ]]; then
    redis_doctor DEV "$REDIS_DEV_CONTAINER" "${REDIS_PREFIX}:dev" "$REDIS_DEV_HOST" "$REDIS_DEV_PORT"
    redis_doctor TEST "$REDIS_TEST_CONTAINER" "${REDIS_PREFIX}:test" "$REDIS_TEST_HOST" "$REDIS_TEST_PORT"
  fi
  for_each_render_row check_local_modes
}

print_plan() {
  printf 'Project: %s\n' "$PROJECT_KEY"
  printf 'DEV PostgreSQL:  %s@%s:%s/%s\n' "$DEV_DB_ROLE" "$PG_DEV_HOST" "$PG_DEV_PORT" "$DEV_DB_NAME"
  printf 'TEST PostgreSQL: %s@%s:%s/%s (CREATEDB=%s)\n' "$TEST_DB_ROLE" "$PG_TEST_HOST" "$PG_TEST_PORT" "$TEST_DB_NAME" "$TEST_ROLE_CREATEDB"
  if [[ "$USE_REDIS" == "yes" ]]; then
    printf 'Redis DEV:       %s:%s namespace=%s:dev\n' "$REDIS_DEV_HOST" "$REDIS_DEV_PORT" "$REDIS_PREFIX"
    printf 'Redis TEST:      %s:%s namespace-base=%s:test\n' "$REDIS_TEST_HOST" "$REDIS_TEST_PORT" "$REDIS_PREFIX"
  else
    printf 'Redis:           not used by this project\n'
  fi
  printf 'Central secrets: %s\n' "$CENTRAL_SECRETS"
  printf 'DEV secret key:  %s [%s]\n' "$DEV_SECRET_KEY" "$( [[ -n "$(kv_get "$CENTRAL_SECRETS" "$DEV_SECRET_KEY")" ]] && echo present || echo missing )"
  printf 'TEST secret key: %s [%s]\n' "$TEST_SECRET_KEY" "$( [[ -n "$(kv_get "$CENTRAL_SECRETS" "$TEST_SECRET_KEY")" ]] && echo present || echo missing )"
  if supplemental_map_configured; then
    printf 'Supplemental secrets map: %s\n' "$SUPPLEMENTAL_SECRETS"
    printf 'Supplemental bindings:\n'
    for_each_supplemental_row print_supplemental_row
  fi
  printf 'Rendered env files:\n'
  python3 -c '
from pathlib import Path
import sys
for raw in Path(sys.argv[1]).read_text().splitlines():
    if not raw.strip() or raw.lstrip().startswith("#"): continue
    p=raw.split("\t")
    print(f"  - profile={p[0].strip()} target={p[2].strip()} template={p[1].strip()}")
' "$RENDER_MAP"
}

print_supplemental_row() {
  local profile="$1" env_var="$2" secret_key="$3"
  printf '  - profile=%s env_var=%s secret_key=%s [%s]\n' \
    "$profile" "$env_var" "$secret_key" \
    "$( [[ -n "$(kv_get "$CENTRAL_SECRETS" "$secret_key")" ]] && echo present || echo missing )"
}

rotate_all() {
  require_no_xtrace
  preflight_operational_contract
  local old_dev old_test new_dev new_test
  old_dev="$(kv_get "$CENTRAL_SECRETS" "$DEV_SECRET_KEY")"
  old_test="$(kv_get "$CENTRAL_SECRETS" "$TEST_SECRET_KEY")"
  [[ -n "$old_dev" && -n "$old_test" ]] || die "cannot rotate missing credentials; run activate first"
  new_dev="$(generate_secret)"
  new_test="$(generate_secret)"

  kv_set_secret "$CENTRAL_SECRETS" "$DEV_SECRET_KEY" "$new_dev"
  kv_set_secret "$CENTRAL_SECRETS" "$TEST_SECRET_KEY" "$new_test"

  if ! provision_database "$PG_DEV_CONTAINER" "$DEV_DB_ROLE" "$DEV_DB_NAME" "$new_dev" no || \
     ! provision_database "$PG_TEST_CONTAINER" "$TEST_DB_ROLE" "$TEST_DB_NAME" "$new_test" "$TEST_ROLE_CREATEDB"; then
    warn "rotation failed; restoring prior central values and role passwords"
    kv_set_secret "$CENTRAL_SECRETS" "$DEV_SECRET_KEY" "$old_dev"
    kv_set_secret "$CENTRAL_SECRETS" "$TEST_SECRET_KEY" "$old_test"
    provision_database "$PG_DEV_CONTAINER" "$DEV_DB_ROLE" "$DEV_DB_NAME" "$old_dev" no || true
    provision_database "$PG_TEST_CONTAINER" "$TEST_DB_ROLE" "$TEST_DB_NAME" "$old_test" "$TEST_ROLE_CREATEDB" || true
    die "credential rotation rolled back"
  fi

  render_all
  doctor_all
  pass "rotated DEV and TEST credentials for $PROJECT_KEY; values were not printed"
}

run_profile() {
  local profile="$1"; shift
  validate_profile_value "run" "$profile"
  [[ "${1-}" == "--" ]] || die "usage: $PROGRAM run PROFILE -- COMMAND [ARGS...]"
  shift
  [[ $# -gt 0 ]] || die "run requires a command"
  require_supplemental_secrets_for_profile "$profile"
  python3 -c '
from pathlib import Path
import os,sys
profile=sys.argv[1]
render_map=Path(sys.argv[2])
supplemental_map=sys.argv[3] if len(sys.argv)>3 and sys.argv[3] else ""
secret_file=Path(sys.argv[4]) if len(sys.argv)>4 and sys.argv[4] else None
cmd=sys.argv[5:]

def parse_secrets(path):
    out={}
    if path is None or not path.exists():
        return out
    for raw in path.read_text().splitlines():
        line=raw.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key,value=line.split("=",1)
        key=key.strip()
        if key not in out:
            out[key]=value.strip()
    return out

def supplemental_bindings(active_profile):
    if not supplemental_map:
        return {}
    rows=[]
    seen=set()
    for raw in Path(supplemental_map).read_text().splitlines():
        if not raw.strip() or raw.lstrip().startswith("#"):
            continue
        parts=raw.split("\t")
        if len(parts)!=3:
            raise SystemExit(
                "Invalid supplemental-secrets row (need PROFILE<TAB>ENV_VAR<TAB>SECRET_KEY): "
                + raw
            )
        binding_profile,env_var,secret_key=[part.strip() for part in parts]
        key=(binding_profile,env_var)
        if key in seen:
            raise SystemExit(
                f"duplicate supplemental binding for profile={binding_profile} env_var={env_var}"
            )
        seen.add(key)
        rows.append((binding_profile,env_var,secret_key))
    secrets=parse_secrets(secret_file)
    def applies(binding_profile, render_profile):
        if render_profile=="all":
            return binding_profile=="all"
        return binding_profile==render_profile or binding_profile=="all"
    by_env={}
    for binding_profile,env_var,secret_key in rows:
        if not applies(binding_profile, active_profile):
            continue
        if env_var in by_env:
            raise SystemExit(
                f"ambiguous supplemental env_var {env_var} for profile {active_profile}"
            )
        if secret_key not in secrets or not secrets[secret_key]:
            raise SystemExit(
                f"missing {secret_key} in {secret_file}; supplemental secret must exist locally"
            )
        by_env[env_var]=secrets[secret_key]
    return by_env

def parse_env(path, env):
    if not path.exists():
        raise SystemExit(f"Missing local env file: {path}. Run devcore-project activate first.")
    for raw in path.read_text().splitlines():
        line=raw.strip()
        if not line or line.startswith("#") or "=" not in line: continue
        if line.startswith("export "): line=line[7:].lstrip()
        k,v=line.split("=",1); k=k.strip(); v=v.strip()
        if len(v)>=2 and v[0]==v[-1] and v[0] in (chr(34), chr(39)):
            v=v[1:-1]
        env[k]=v

bindings=supplemental_bindings(profile)
declared_env_vars=set()
if supplemental_map:
    for raw in Path(supplemental_map).read_text().splitlines():
        if not raw.strip() or raw.lstrip().startswith("#"):
            continue
        parts=raw.split("\t")
        if len(parts)==3:
            declared_env_vars.add(parts[1].strip())
env=os.environ.copy()
for key in declared_env_vars:
    env.pop(key, None)
for raw in render_map.read_text().splitlines():
    if not raw.strip() or raw.lstrip().startswith("#"): continue
    parts=raw.split("\t")
    row_profile,target=parts[0].strip(),Path(parts[2].strip())
    if row_profile in ("all",profile): parse_env(target,env)
for key,value in bindings.items():
    env[key]=value
os.execvpe(cmd[0],cmd,env)
' "$profile" "$RENDER_MAP" "${SUPPLEMENTAL_SECRETS:-}" "$CENTRAL_SECRETS" "$@"
}

mutation_lock_helper() {
  python3 - "$@" <<'PY'
import fcntl
import hashlib
import os
import pwd
import stat
import sys
from pathlib import Path

action = sys.argv[1]
uid = os.getuid()

def normalized_state_path(raw):
    path = Path(raw).expanduser()
    if not path.is_absolute():
        path = Path.cwd() / path
    if not path.name or path.name in (".", ".."):
        raise RuntimeError("central state file path must name a file")
    canonical = path.parent.resolve(strict=False) / path.name
    try:
        entry = canonical.lstat()
    except FileNotFoundError:
        entry = None
    if entry is not None and stat.S_ISLNK(entry.st_mode):
        raise RuntimeError(f"central state file must not be a symlink: {canonical}")
    return canonical

def state_paths(secret_raw, global_raw):
    secret_path = normalized_state_path(secret_raw)
    global_path = normalized_state_path(global_raw)
    if secret_path == global_path:
        raise RuntimeError("DEVCORE_SECRETS_FILE and DEVCORE_GLOBAL_CONF must identify different files")
    return secret_path, global_path

def lock_name(path):
    digest = hashlib.sha256(os.fsencode(str(path))).hexdigest()
    return f"state-{digest}.lock"

def ensure_lock_directory():
    home = Path(pwd.getpwuid(uid).pw_dir)
    config = home / ".config"
    devcore = config / "dev-core"
    lock_dir = devcore / "locks"
    chain = ((home, None), (config, None), (devcore, 0o700), (lock_dir, 0o700))
    for path, required_mode in chain:
        try:
            entry = path.lstat()
        except FileNotFoundError:
            if path == home:
                raise RuntimeError("account home directory is missing")
            try:
                path.mkdir(mode=required_mode or 0o700)
            except FileExistsError:
                pass
            entry = path.lstat()
        if stat.S_ISLNK(entry.st_mode) or not stat.S_ISDIR(entry.st_mode):
            raise RuntimeError("DevCore mutation lock directory path must contain only real directories")
        if entry.st_uid != uid:
            raise RuntimeError("DevCore mutation lock directories must be owned by this user")
        if required_mode is not None and stat.S_IMODE(entry.st_mode) != required_mode:
            raise RuntimeError("DevCore mutation lock directories must have mode 0700")
        if path in (home, config) and stat.S_IMODE(entry.st_mode) & 0o022:
            raise RuntimeError("DevCore mutation lock parent directories must not be group- or world-writable")

    flags = os.O_RDONLY | getattr(os, "O_DIRECTORY", 0) | getattr(os, "O_NOFOLLOW", 0)
    directory_fd = os.open(lock_dir, flags)
    opened = os.fstat(directory_fd)
    current = lock_dir.lstat()
    if (opened.st_dev, opened.st_ino) != (current.st_dev, current.st_ino):
        os.close(directory_fd)
        raise RuntimeError("DevCore mutation lock directory changed during validation")
    return lock_dir, directory_fd

def validate_lock_file(directory_fd, name, fd):
    opened = os.fstat(fd)
    try:
        current = os.stat(name, dir_fd=directory_fd, follow_symlinks=False)
    except FileNotFoundError:
        raise RuntimeError("mutation lock file disappeared during validation")
    if stat.S_ISLNK(current.st_mode) or not stat.S_ISREG(opened.st_mode):
        raise RuntimeError("mutation lock must be a regular file, not a symlink")
    if (opened.st_dev, opened.st_ino) != (current.st_dev, current.st_ino):
        raise RuntimeError("mutation lock changed during validation")
    if opened.st_uid != uid or stat.S_IMODE(opened.st_mode) != 0o600:
        raise RuntimeError("mutation lock must be owned by this user with mode 0600")
    if opened.st_nlink != 1:
        raise RuntimeError("mutation lock must not have additional hard links")

try:
    secrets, global_conf = state_paths(sys.argv[2], sys.argv[3])
    names = [(lock_name(secrets), secrets), (lock_name(global_conf), global_conf)]
    names.sort(key=lambda item: item[0])
    lock_dir, directory_fd = ensure_lock_directory()

    if action == "acquire":
        script = str(Path(sys.argv[4]).resolve(strict=True))
        command = sys.argv[5]
        args = sys.argv[6:]
        descriptors = []
        try:
            flags = os.O_CREAT | os.O_RDWR | getattr(os, "O_NOFOLLOW", 0)
            for name, _path in names:
                fd = os.open(name, flags, 0o600, dir_fd=directory_fd)
                descriptors.append(fd)
                validate_lock_file(directory_fd, name, fd)
                try:
                    fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                except BlockingIOError:
                    raise RuntimeError("another DevCore mutation holds a state lock")

            os.close(directory_fd)
            directory_fd = -1
            for fd in descriptors:
                os.set_inheritable(fd, True)
            os.environ["DEVCORE_MUTATION_LOCK_FDS"] = ",".join(str(fd) for fd in descriptors)
            os.environ["DEVCORE_MUTATION_SECRETS_PATH"] = str(secrets)
            os.environ["DEVCORE_MUTATION_GLOBAL_CONF_PATH"] = str(global_conf)
            os.execv(script, [script, command, *args])
        finally:
            if directory_fd >= 0:
                os.close(directory_fd)
            for fd in descriptors:
                os.close(fd)
    elif action == "validate":
        descriptors = [int(value) for value in os.environ["DEVCORE_MUTATION_LOCK_FDS"].split(",")]
        if len(descriptors) != len(names):
            raise RuntimeError("inherited mutation lock descriptor count is invalid")
        for (name, _path), fd in zip(names, descriptors):
            validate_lock_file(directory_fd, name, fd)
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    else:
        raise RuntimeError("unknown mutation lock helper action")
except (OSError, RuntimeError, ValueError, KeyError, IndexError) as error:
    if action == "validate":
        raise SystemExit(f"ERROR: invalid inherited mutation lock: {error}")
    raise SystemExit(f"ERROR: cannot acquire mutation lock: {error}")
finally:
    if "directory_fd" in locals() and directory_fd >= 0:
        os.close(directory_fd)
PY
}

acquire_mutation_lock() {
  mutation_lock_helper acquire "$CENTRAL_SECRETS" "$GLOBAL_CONF" "$0" "$1" "${@:2}"
  exit $?
}

validate_inherited_mutation_lock() {
  mutation_lock_helper validate "$CENTRAL_SECRETS" "$GLOBAL_CONF"
}

cmd_init() {
  local project_key="" dev_role="" dev_db="" test_role="" test_db=""
  local redis_prefix="" dev_secret_key="" test_secret_key="" test_createdb="yes" use_redis="yes"
  local local_env_file=".env.local" force="no"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --project-key) project_key="$2"; shift 2 ;;
      --dev-role) dev_role="$2"; shift 2 ;;
      --dev-db) dev_db="$2"; shift 2 ;;
      --test-role) test_role="$2"; shift 2 ;;
      --test-db) test_db="$2"; shift 2 ;;
      --redis-prefix) redis_prefix="$2"; shift 2 ;;
      --dev-secret-key) dev_secret_key="$2"; shift 2 ;;
      --test-secret-key) test_secret_key="$2"; shift 2 ;;
      --test-createdb) test_createdb="$2"; shift 2 ;;
      --use-redis) use_redis="$2"; shift 2 ;;
      --local-env-file) local_env_file="$2"; shift 2 ;;
      --force) force="yes"; shift ;;
      *) die "unknown init option: $1" ;;
    esac
  done
  [[ -n "$project_key" && -n "$dev_role" && -n "$dev_db" && -n "$test_role" && -n "$test_db" ]] || \
    die "init requires --project-key --dev-role --dev-db --test-role --test-db"
  [[ "$test_createdb" == "yes" || "$test_createdb" == "no" ]] || die "--test-createdb must be yes or no"
  [[ "$use_redis" == "yes" || "$use_redis" == "no" ]] || die "--use-redis must be yes or no"
  redis_prefix="${redis_prefix:-$project_key}"
  local upper
  upper="$(normalize_secret_key "$project_key")"
  dev_secret_key="${dev_secret_key:-${upper}_DEV_DB_PASSWORD}"
  test_secret_key="${test_secret_key:-${upper}_TEST_DB_PASSWORD}"

  if [[ -e .devcore && "$force" != "yes" ]]; then
    die ".devcore already exists; use --force only after reviewing existing project contract"
  fi
  mkdir -p .devcore
  cat > .devcore/project.conf <<EOF_CONF
# Committed, non-secret project allocation for the workstation dev-core stack.
PROJECT_KEY=$project_key
DEV_DB_ROLE=$dev_role
DEV_DB_NAME=$dev_db
TEST_DB_ROLE=$test_role
TEST_DB_NAME=$test_db
DEV_SECRET_KEY=$dev_secret_key
TEST_SECRET_KEY=$test_secret_key
TEST_ROLE_CREATEDB=$test_createdb
USE_REDIS=$use_redis
REDIS_PREFIX=$redis_prefix
RENDER_MAP=.devcore/render-map.tsv
EOF_CONF
  cat > .devcore/env.local.template <<'EOF_TEMPLATE'
# Customize these variable names to the repository's real config contract.
DEV_DATABASE_USERNAME={{DEV_DB_ROLE}}
DEV_DATABASE_PASSWORD={{DEV_DB_PASSWORD}}
DEV_DATABASE_HOST={{DEV_DB_HOST}}
DEV_DATABASE_PORT={{DEV_DB_PORT}}
DEV_DATABASE_NAME={{DEV_DB_NAME}}
TEST_DATABASE_USERNAME={{TEST_DB_ROLE}}
TEST_DATABASE_PASSWORD={{TEST_DB_PASSWORD}}
TEST_DATABASE_HOST={{TEST_DB_HOST}}
TEST_DATABASE_PORT={{TEST_DB_PORT}}
TEST_DATABASE_NAME={{TEST_DB_NAME}}
REDIS_DEV_URL=redis://{{REDIS_DEV_HOST}}:{{REDIS_DEV_PORT}}
REDIS_TEST_URL=redis://{{REDIS_TEST_HOST}}:{{REDIS_TEST_PORT}}
REDIS_DEV_NAMESPACE={{REDIS_DEV_NAMESPACE}}
REDIS_TEST_NAMESPACE_BASE={{REDIS_TEST_NAMESPACE_BASE}}
EOF_TEMPLATE
  printf 'all\t.devcore/env.local.template\t%s\t\n' "$local_env_file" > .devcore/render-map.tsv
  cat > .devcore/README.md <<'EOF_README'
# dev-core local contract

These files are committed and contain no secrets.

1. Edit `env.local.template` so its variable names exactly match this repository.
2. Ensure every render target in `render-map.tsv` is ignored by Git.
3. Add obsolete local variable names to the optional fourth TSV column as a comma-separated purge list.
4. Run `devcore-project activate` from the repository root.

Redis namespaces are key prefixes, not server-side resources. Tests should append a per-run nonce to the TEST namespace base when concurrent isolation matters.
EOF_README
  pass "created .devcore skeleton for $project_key"
  warn "customize .devcore/env.local.template and ensure '$local_env_file' is gitignored before activate"
}


slots_main() {
  python3 /dev/fd/3 "$0" "$PROJECT_CONF" "$GLOBAL_CONF" "$CENTRAL_SECRETS" "$CENTRAL_DIR" "$@" 3<<'DEVCORE_SLOTS_PYTHON'
# DEVCORE_SLOTS_PYTHON_BEGIN
"""Opt-in Linux workstation leases. Embedded to preserve single-file releases."""
import argparse
import contextlib
import copy
import ctypes
import fcntl
import hashlib
import json
import os
import pwd
import re
import secrets
import signal
import shutil
import socket
import stat
import subprocess
import sys
import tempfile
import time
import uuid
from pathlib import Path


class SlotError(RuntimeError):
    """A non-secret operational diagnosis safe for normal CLI output."""


class ConnectionBoundaryError(SlotError):
    """Legacy CONNECT requires separate authority; never expose raw SQL errors."""


def newyou_contract():
    return {
        "version": 1, "project": "new_you", "slots": 20, "http_base": 4220,
        "test_host": "127.0.0.1", "test_port": 55433,
        "database_prefix": "dc_new_you_s", "dev_database": "new_you_dev",
        "legacy_test_database": "new_you_test",
        "test_container": "dev-core-postgres-test-1", "admin_role": "devcore_admin",
        "database_owner": "devcore_admin",
    }


def validate_contract(contract):
    expected = newyou_contract()
    if contract != expected:
        raise SlotError("unsupported slot contract; version 1 requires the exact NewYou manifest")


def private_path(path, directory=False, create=False):
    path = Path(path)
    if create:
        try:
            if directory:
                path.mkdir(mode=0o700)
            else:
                fd = os.open(path, os.O_CREAT | os.O_EXCL | os.O_WRONLY | os.O_NOFOLLOW, 0o600)
                os.close(fd)
        except FileExistsError:
            pass
    entry = path.lstat()
    wanted = stat.S_ISDIR if directory else stat.S_ISREG
    mode = 0o700 if directory else 0o600
    if (not wanted(entry.st_mode) or entry.st_uid != os.getuid()
            or stat.S_IMODE(entry.st_mode) != mode or (not directory and entry.st_nlink != 1)):
        raise SlotError("slot metadata must be private, owned, and free of links")
    return path


def atomic_json(path, value):
    path = Path(path)
    if path.exists() or path.is_symlink():
        private_path(path)
    fd, temporary = tempfile.mkstemp(prefix=".slot-", dir=path.parent)
    try:
        with os.fdopen(fd, "w") as stream:
            json.dump(value, stream, sort_keys=True)
            stream.write("\n")
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
        directory = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def process_identity(pid=None):
    pid = pid or os.getpid()
    try:
        fields = Path(f"/proc/{pid}/stat").read_text().rsplit(")", 1)[1].split()
        return {"pid": pid, "start": fields[19], "boot": Path("/proc/sys/kernel/random/boot_id").read_text().strip()}
    except (OSError, IndexError):
        raise SlotError("Linux process identity is unavailable") from None


def process_alive(identity):
    try:
        return identity == process_identity(identity["pid"])
    except (SlotError, KeyError):
        return False


def reserve_port(port):
    held = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    try:
        held.bind(("127.0.0.1", port))
        held.listen(1)
        return held
    except OSError:
        held.close()
        raise SlotError("HTTP port is occupied; its owner must stop or adopt it") from None


def port_available(port):
    try:
        held = reserve_port(port)
        held.close()
        return True
    except SlotError:
        return False


def target_identity(row):
    return f"dc_new_you_s{row['slot']:02d}_g{row['generation']}"


class GitHubApproval:
    """Verify one owner-authored approval, then retain its non-secret receipt locally."""
    @staticmethod
    def text(digest):
        return ("DEVCORE_SLOT_APPROVAL_V1\nmanifest-sha256: " + digest +
                "\nI authorize creation and automatic cleanup of only the registered NewYou "
                "disposable TEST generations described by this exact manifest. Existing databases "
                "and unknown sessions must remain untouched.")

    @classmethod
    def verify(cls, digest, reference):
        match = re.fullmatch(r"https://github\.com/Carpe-Diem-Media/devcore-project/(?:pull|issues)/(\d+)#issuecomment-(\d+)", reference)
        if not match:
            raise SlotError("owner authorization requires the exact GitHub approval comment URL")
        issue, comment = match.groups()
        result = subprocess.run(["gh", "api", f"repos/Carpe-Diem-Media/devcore-project/issues/comments/{comment}"],
                                capture_output=True, text=True, timeout=30)
        if result.returncode:
            raise SlotError("cannot verify owner authorization with GitHub")
        data = json.loads(result.stdout)
        if (data.get("user", {}).get("login") != "JCSchoeman96"
                or data.get("html_url") != reference
                or data.get("issue_url") != f"https://api.github.com/repos/Carpe-Diem-Media/devcore-project/issues/{issue}"
                or data.get("body", "").strip() != cls.text(digest)):
            raise SlotError("owner approval author, target or exact manifest text does not match")
        return {"author": "JCSchoeman96", "comment": comment, "url": reference, "verified_at": int(time.time())}


class Pool:
    """Registry transitions; resource side effects occur only through the adapter."""
    def __init__(self, root, contract, resources, port_available=port_available, approval_check=GitHubApproval.verify):
        validate_contract(contract)
        self.root = private_path(root, directory=True, create=True)
        self.contract = copy.deepcopy(contract)
        self.resources = resources
        self.port_available = port_available
        self.process_alive = process_alive
        self.approval_check = approval_check
        private_path(self.root / "registry.lock", create=True)

    def manifest(self):
        return {"contract": self.contract, "registry": str(self.root.resolve()),
                "targets": [{"slot": slot, "port": 4220 + slot,
                             "database": f"dc_new_you_s{slot:02d}_g<32 lowercase UUID hex>",
                             "role": f"dc_new_you_s{slot:02d}_g<same generation>_r"}
                            for slot in range(1, 21)],
                "cleanup": "registered generation, catalog OIDs and ownership comments, no jobs, zero clients; no FORCE",
                "protected": ["new_you_dev", "new_you_test", "postgres", "template0", "template1", "unregistered targets"]}

    def manifest_digest(self):
        return hashlib.sha256(json.dumps(self.manifest(), sort_keys=True).encode()).hexdigest()

    @contextlib.contextmanager
    def registry(self):
        path = self.root / "registry.lock"
        private_path(path)
        fd = os.open(path, os.O_RDWR | os.O_NOFOLLOW)
        try:
            fcntl.flock(fd, fcntl.LOCK_EX)
            opened, current = os.fstat(fd), path.lstat()
            if (opened.st_dev, opened.st_ino) != (current.st_dev, current.st_ino):
                raise SlotError("registry lock changed during acquisition")
            data_path = self.root / "registry.json"
            if data_path.exists() or data_path.is_symlink():
                private_path(data_path)
                state = json.loads(data_path.read_text())
                if state.get("version") != 1 or state.get("manifest") != self.manifest_digest():
                    raise SlotError("registry manifest changed; preserve existing allocations")
            else:
                state = {"version": 1, "manifest": self.manifest_digest(), "slots": {}}
            original = copy.deepcopy(state)
            yield state
            if state != original:
                atomic_json(data_path, state)
        finally:
            os.close(fd)

    def enable(self, digest, approval_ref):
        if digest != self.manifest_digest():
            raise SlotError("owner authorization must name the exact manifest digest")
        receipt = self.approval_check(digest, approval_ref)
        with self.registry() as state:
            state["authorization"] = {"manifest": digest, "receipt": receipt}
            state["acquisition_enabled"] = True

    def disable(self):
        with self.registry() as state:
            state["acquisition_enabled"] = False

    def authorized(self, state):
        if state.get("authorization", {}).get("manifest") != self.manifest_digest():
            raise SlotError("slot activation and disposable cleanup authorization are required")

    def validate_target(self, row):
        if (type(row.get("slot")) is not int or row["slot"] not in range(1, 21)
                or not re.fullmatch(r"[0-9a-f]{32}", row.get("generation", ""))
                or not re.fullmatch(r"[0-9a-f]{32}", row.get("lease_id", ""))):
            raise SlotError("invalid registered slot identity")
        expected = target_identity(row)
        if (row.get("database") != expected or row.get("role") != expected + "_r"
                or row.get("port") != 4220 + row["slot"]
                or row.get("test_host") != "127.0.0.1" or row.get("test_port") != 55433
                or row.get("project") != "new_you" or row.get("manifest") != self.manifest_digest()):
            raise SlotError("protected or unregistered target; refusing resource operation")

    def owned(self, state, lease_id, generation, worktree):
        for row in state["slots"].values():
            if row["lease_id"] == lease_id:
                if row["generation"] != generation or row["worktree"] != str(Path(worktree).resolve(strict=True)):
                    raise SlotError("stale generation or different canonical worktree")
                self.validate_target(row)
                return row
        raise SlotError("stale lease; no resource operation performed")

    def acquire(self, worktree, wait=0, cancelled=lambda: False):
        deadline = time.monotonic() + wait
        worktree = str(Path(worktree).resolve(strict=True))
        while True:
            if cancelled():
                raise SlotError("slot wait cancelled")
            candidate = None
            with self.registry() as state:
                self.authorized(state)
                if not state.get("acquisition_enabled", False):
                    raise SlotError("new slot acquisition is disabled; active leases remain owned")
                for slot in range(1, 21):
                    old = state["slots"].get(str(slot))
                    if old and old["state"] != "free":
                        continue
                    if not self.port_available(4220 + slot):
                        continue
                    candidate = {"slot": slot, "port": 4220 + slot, "project": "new_you",
                                 "lease_id": uuid.uuid4().hex, "generation": uuid.uuid4().hex,
                                 "worktree": worktree, "state": "preparing", "jobs": {},
                                 "test_host": "127.0.0.1", "test_port": 55433,
                                 "manifest": self.manifest_digest(), "preparer": process_identity()}
                    candidate["database"] = target_identity(candidate)
                    candidate["role"] = candidate["database"] + "_r"
                    state["slots"][str(slot)] = candidate
                    break
            if candidate:
                break
            if time.monotonic() >= deadline:
                raise SlotError("slots exhausted or ports blocked; shared TEST fallback is forbidden")
            time.sleep(min(0.05, max(0, deadline - time.monotonic())))
        try:
            catalog = self.resources.prepare(copy.deepcopy(candidate))
        except Exception as error:
            boundary = isinstance(error, ConnectionBoundaryError)
            diagnosis = ("legacy TEST PUBLIC CONNECT is unsafe or unknown; separate approval required; no resources created"
                         if boundary
                         else "preparation incomplete; exact-target inspection required")
            with self.registry() as state:
                row = self.owned(state, candidate["lease_id"], candidate["generation"], worktree)
                # Only this typed adapter rejection proves it occurred before
                # credentials or mutations. Unknown failures remain quarantined.
                row.update(state="free" if boundary else "quarantined", diagnosis=diagnosis)
            raise SlotError(("slot not acquired; " if boundary else "slot quarantined after preparation failure; ")
                            + diagnosis) from None
        with self.registry() as state:
            row = self.owned(state, candidate["lease_id"], candidate["generation"], worktree)
            if row["state"] != "preparing":
                raise SlotError("preparation ownership changed; slot requires inspection")
            row.update(catalog=catalog, state="ready")
            return copy.deepcopy(row)

    def status(self):
        with self.registry() as state:
            return copy.deepcopy(list(state["slots"].values()))

    def retain(self, lease_id, generation, worktree, diagnosis=None):
        with self.registry() as state:
            row = self.owned(state, lease_id, generation, worktree)
            if row["jobs"] or row["state"] not in ("ready", "retained"):
                raise SlotError("retain requires an idle ready or retained lease")
            row["state"] = "retained"
            if diagnosis is not None:
                row["diagnosis"] = diagnosis

    def begin_job(self, lease_id, generation, worktree, profile="test"):
        if profile not in ("dev", "test"):
            raise SlotError("managed job profile must be dev or test")
        with self.registry() as state:
            row = self.owned(state, lease_id, generation, worktree)
            if row["state"] not in ("ready", "retained") or row["jobs"]:
                raise SlotError("lease is not available for a managed job")
            job = uuid.uuid4().hex
            row["jobs"][job] = {"supervisor": process_identity(), "session": None, "profile": profile}
            row["state"] = "in_use"
            return job

    def set_session(self, lease_id, generation, worktree, job, pid):
        with self.registry() as state:
            row = self.owned(state, lease_id, generation, worktree)
            row["jobs"][job]["session"] = process_identity(pid)

    def end_job(self, lease_id, generation, worktree, job, result):
        with self.registry() as state:
            row = self.owned(state, lease_id, generation, worktree)
            if job not in row["jobs"] or row["jobs"][job]["supervisor"] != process_identity():
                raise SlotError("stale managed job completion")
            del row["jobs"][job]
            if row["state"] != "quarantined":
                row["state"] = "ready" if result == 0 else "retained"
            row["last_exit"] = result

    def quarantine(self, lease_id, generation, worktree, diagnosis):
        with self.registry() as state:
            row = self.owned(state, lease_id, generation, worktree)
            row.update(state="quarantined", diagnosis=diagnosis)

    def release(self, lease_id, generation, worktree, retry=False):
        with self.registry() as state:
            self.authorized(state)
            row = self.owned(state, lease_id, generation, worktree)
            if row["jobs"]:
                raise SlotError("managed job still owns resources; release refused")
            if row["state"] == "free":
                return
            retryable = retry and row["state"] == "quarantined" and row.get("cleanup_retry", False)
            if row["state"] not in ("ready", "retained") and not retryable:
                raise SlotError("quarantined or incomplete slot requires exact-target diagnosis")
            row["state"] = "cleaning"
            row["cleaner"] = process_identity()
            target = copy.deepcopy(row)
        failed = False
        try:
            self.resources.cleanup(target)
        except Exception:
            failed = True
        with self.registry() as state:
            row = self.owned(state, lease_id, generation, worktree)
            if failed:
                row.update(state="quarantined", cleanup_retry=True, diagnosis="cleanup uncertain or clients remain; retry requires both recorded identities; partial removal needs exact-target review")
            else:
                row.update(state="free", diagnosis="exact registered generation removed")
        if failed:
            raise SlotError("cleanup failed; slot quarantined and unavailable")

    def recover(self):
        with self.registry() as state:
            for row in state["slots"].values():
                dead_job = any(not self.process_alive(job["supervisor"]) for job in row["jobs"].values())
                interrupted = ((row["state"] == "preparing" and not self.process_alive(row["preparer"]))
                               or (row["state"] == "cleaning" and not self.process_alive(row["cleaner"])))
                if dead_job or interrupted:
                    row.update(state="quarantined", diagnosis="interrupted ownership; preserve descendants and inspect exact targets")
        return self.status()


# CLI and PostgreSQL adapter are defined below.

def ownership_comment(row):
    worktree = hashlib.sha256(row["worktree"].encode()).hexdigest()
    return f"devcore-slot:v1:new_you:{row['lease_id']}:{row['generation']}:{worktree}:{row['manifest']}"


def sql_literal(value):
    return "'" + str(value).replace("'", "''") + "'"


class Postgres:
    """Administrative adapter. SQL and passwords go only to standard input."""
    def __init__(self, contract, password, executor=None, endpoint=None):
        validate_contract(contract)
        self.contract = contract
        self.password = password
        self.executor = executor or self.execute
        self.endpoint = endpoint or self.check_endpoint
        self.bound_container = None

    def validate(self, row):
        if (row.get("project") != "new_you" or type(row.get("slot")) is not int
                or row["slot"] not in range(1, 21)
                or not re.fullmatch(r"[0-9a-f]{32}", row.get("generation", ""))
                or not re.fullmatch(r"[0-9a-f]{32}", row.get("lease_id", ""))
                or row.get("database") != target_identity(row)
                or row.get("role") != target_identity(row) + "_r"):
            raise SlotError("protected or unregistered database identity")

    def check_endpoint(self):
        result = subprocess.run(["docker", "inspect", "-f", "{{.Id}}", self.contract["test_container"]],
                                capture_output=True, text=True, timeout=15)
        container_id = result.stdout.strip()
        if result.returncode or not re.fullmatch(r"[a-f0-9]{64}", container_id):
            raise SlotError("cannot establish TEST container identity")
        for arguments, expected in ((["port", container_id, "5432/tcp"], "127.0.0.1:55433"),
                                    (["inspect", "-f", "{{.State.Running}}", container_id], "true")):
            result = subprocess.run(["docker", *arguments], capture_output=True, text=True, timeout=15)
            if result.returncode or result.stdout.strip() != expected:
                raise SlotError("TEST container does not match the approved running loopback endpoint")
        return container_id

    def execute(self, statement):
        if not self.bound_container or not re.fullmatch(r"[a-f0-9]{64}", self.bound_container):
            raise SlotError("administrative SQL requires an inspected container identity")
        result = subprocess.run(
            ["docker", "exec", "-i", self.bound_container, "psql", "-X", "-qAt",
             "-v", "ON_ERROR_STOP=1", "-U", self.contract["admin_role"], "-d", "postgres"],
            input=statement, capture_output=True, text=True, timeout=60)
        if result.returncode:
            # PostgreSQL errors may quote SQL containing credentials. Never forward them.
            raise SlotError("administrative TEST SQL failed; slot preserved for diagnosis")
        return result.stdout.strip()

    def catalog(self, row):
        database, role = sql_literal(row["database"]), sql_literal(row["role"])
        result = self.executor(f"""
SELECT json_build_object(
 'database_oid', d.oid::bigint, 'role_oid', r.oid::bigint, 'owner_oid', d.datdba::bigint,
 'admin_oid', a.oid::bigint,
 'database_comment', shobj_description(d.oid, 'pg_database'),
 'role_comment', shobj_description(r.oid, 'pg_authid'),
 'clients', (SELECT count(*) FROM pg_stat_activity WHERE datid = d.oid),
 'privileged', r.rolsuper OR r.rolcreatedb OR r.rolcreaterole OR r.rolreplication OR r.rolbypassrls,
 'memberships', (SELECT count(*) FROM pg_auth_members WHERE roleid=r.oid OR member=r.oid),
 'other_databases', (SELECT count(*) FROM pg_database WHERE datdba=r.oid))
FROM pg_database d JOIN pg_roles r ON r.rolname={role}
JOIN pg_roles a ON a.rolname={sql_literal(self.contract['database_owner'])}
WHERE d.datname={database};
""")
        try:
            return json.loads(result)
        except (ValueError, TypeError):
            raise SlotError("exact database/role catalog ownership is unavailable") from None

    def verify_catalog(self, row, catalog, cleanup=False):
        comment = ownership_comment(row)
        if (catalog.get("owner_oid") != catalog.get("admin_oid")
                or catalog.get("owner_oid") == catalog.get("role_oid")
                or catalog.get("database_comment") != comment or catalog.get("role_comment") != comment
                or catalog.get("privileged") is not False or catalog.get("memberships") != 0
                or catalog.get("other_databases") != 0):
            raise SlotError("catalog ownership or least-privilege identity differs; refusing adoption or cleanup")
        if cleanup and (catalog.get("clients") != 0
                        or any(catalog.get(key) != row["catalog"].get(key) for key in ("database_oid", "role_oid", "owner_oid"))):
            raise SlotError("remaining clients or stale catalog generation; cleanup refused")
        for key in ("database_oid", "role_oid", "owner_oid", "admin_oid"):
            if type(catalog.get(key)) is not int or catalog[key] <= 0:
                raise SlotError("invalid catalog identity")

    def prepare(self, row):
        self.validate(row)
        container_id = self.endpoint()
        self.bound_container = container_id
        database, role = row["database"], row["role"]
        exists = self.executor(f"SELECT EXISTS(SELECT FROM pg_database WHERE datname={sql_literal(database)}) "
                               f"OR EXISTS(SELECT FROM pg_roles WHERE rolname={sql_literal(role)});")
        if exists != "f":
            raise SlotError("database or role already exists; implicit adoption is forbidden")
        # A per-role REVOKE cannot override PUBLIC. Refuse creation until an
        # independently authorized legacy ACL change has closed this boundary.
        public_connect = self.executor("SELECT EXISTS(SELECT FROM "
            "aclexplode(COALESCE(datacl, acldefault('d', datdba))) "
            "WHERE grantee=0 AND privilege_type='CONNECT') "
            "FROM pg_database WHERE datname='new_you_test';")
        if public_connect != "f":
            raise ConnectionBoundaryError("legacy TEST PUBLIC CONNECT is allowed or unknown; "
                                          "managed provisioning requires a separately approved connection boundary")
        password = self.password(row)
        if not re.fullmatch(r"[A-Za-z0-9._:/+=,@%_-]+", password):
            raise SlotError("managed password is not a supported literal")
        comment = sql_literal(ownership_comment(row))
        self.executor(f"CREATE ROLE {role} LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION "
                      f"NOBYPASSRLS PASSWORD {sql_literal(password)};\nCOMMENT ON ROLE {role} IS {comment};")
        # CREATE without IF NOT EXISTS deliberately fails on a race rather than adopting it.
        # Runtime credentials may create migration objects, but must never own
        # the database or acquire grant options that reopen cross-slot CONNECT.
        self.executor(f"CREATE DATABASE {database} OWNER {self.contract['database_owner']} "
                      "TEMPLATE template0 ALLOW_CONNECTIONS false;")
        self.executor(f"COMMENT ON DATABASE {database} IS {comment};\n"
                      f"REVOKE ALL ON DATABASE {database} FROM PUBLIC;\n"
                      f"GRANT CONNECT, TEMPORARY ON DATABASE {database} TO {role};\n"
                      f"ALTER DATABASE {database} ALLOW_CONNECTIONS true;\n"
                      f"\\connect {database}\n"
                      f"GRANT USAGE, CREATE ON SCHEMA public TO {role};")
        catalog = self.catalog(row)
        self.verify_catalog(row, catalog)
        return {"database_oid": catalog["database_oid"], "role_oid": catalog["role_oid"],
                "owner_oid": catalog["owner_oid"], "container_id": container_id}

    def cleanup(self, row):
        self.validate(row)
        container_id = self.endpoint()
        if container_id != row["catalog"].get("container_id"):
            raise SlotError("TEST container identity changed; cleanup refused")
        self.bound_container = container_id
        self.verify_catalog(row, self.catalog(row), cleanup=True)
        database, role = row["database"], row["role"]
        # Fence new connections, then recheck clients. Never terminate an existing client.
        self.executor(f"ALTER ROLE {role} NOLOGIN;\nALTER DATABASE {database} ALLOW_CONNECTIONS false;")
        self.verify_catalog(row, self.catalog(row), cleanup=True)
        self.executor(f"DROP DATABASE {database};")
        self.executor(f"DROP ROLE {role};")
        result = self.executor(f"SELECT EXISTS(SELECT FROM pg_database WHERE datname={sql_literal(database)}) "
                               f"OR EXISTS(SELECT FROM pg_roles WHERE rolname={sql_literal(role)});")
        if result != "f":
            raise SlotError("database cleanup could not be confirmed")

def parse_pairs(path):
    values = {}
    for raw in Path(path).read_text().splitlines():
        line = raw.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        values.setdefault(key.strip(), value.strip())
    return values


def atomic_text(path, text):
    fd, temporary = tempfile.mkstemp(prefix=".slot-", dir=path.parent)
    try:
        with os.fdopen(fd, "w") as stream:
            stream.write(text)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
        directory = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


class SlotSecrets:
    """Generated runtime secrets stay in DevCore's canonical secret store."""
    def __init__(self, path):
        self.path = private_path(path)

    def key(self, row):
        return "DEVCORE_SLOT_NEW_YOU_" + row["generation"].upper()

    def existing(self, row):
        private_path(self.path)
        value = parse_pairs(self.path).get(self.key(row))
        if not value or not re.fullmatch(r"[a-f0-9]{64}", value):
            raise SlotError("managed generation secret is missing or invalid")
        return value

    def create(self, row):
        # Same canonical per-state lock as Bash mutations, including path overrides.
        home = Path(pwd.getpwuid(os.getuid()).pw_dir)
        config = home / ".config"
        config.mkdir(mode=0o700, exist_ok=True)
        for parent in (home, config):
            entry = parent.lstat()
            if not stat.S_ISDIR(entry.st_mode) or entry.st_uid != os.getuid() or entry.st_mode & 0o022:
                raise SlotError("unsafe central mutation lock parent")
        central = private_path(config / "dev-core", directory=True, create=True)
        locks = private_path(central / "locks", directory=True, create=True)
        digest = hashlib.sha256(os.fsencode(str(self.path.parent.resolve() / self.path.name))).hexdigest()
        lock = private_path(locks / f"state-{digest}.lock", create=True)
        fd = os.open(lock, os.O_RDWR | os.O_NOFOLLOW)
        try:
            fcntl.flock(fd, fcntl.LOCK_EX)
            private_path(self.path)
            values = parse_pairs(self.path)
            if self.key(row) in values:
                raise SlotError("generation secret already exists; refusing reuse")
            value = secrets.token_hex(32)
            body = self.path.read_text()
            atomic_text(self.path, body.rstrip("\n") + f"\n{self.key(row)}={value}\n")
            return value
        finally:
            os.close(fd)


def process_metadata():
    """Read IDs only. Never inspect process arguments, environments or cookies."""
    rows = {}
    for path in Path("/proc").iterdir():
        if not path.name.isdecimal():
            continue
        try:
            fields = (path / "stat").read_text().rsplit(")", 1)[1].split()
            rows[int(path.name)] = (int(fields[1]), int(fields[3]))  # parent, session
        except (OSError, ValueError, IndexError):
            continue
    return rows


def descendants(rows, parent):
    owned = {parent}
    while True:
        new = {pid for pid, (ppid, _) in rows.items() if ppid in owned}
        if new <= owned:
            return owned
        owned.update(new)


def listener_ownership(port, supervisor):
    inodes = set()
    for file in ("/proc/net/tcp", "/proc/net/tcp6"):
        for line in Path(file).read_text().splitlines()[1:]:
            fields = line.split()
            if int(fields[1].split(":")[1], 16) == port and fields[3] == "0A":
                inodes.add(fields[9])
    if not inodes:
        return "absent"
    pids = descendants(process_metadata(), supervisor)
    found = set()
    for pid in pids:
        try:
            files = list(Path(f"/proc/{pid}/fd").iterdir())
        except OSError:
            continue
        for file in files:
            try:
                value = os.readlink(file)
                if value.startswith("socket:["):
                    found.add(value[8:-1])
            except OSError:
                continue
    return "owned" if inodes <= found else "foreign"


class Redactor:
    """Stream redaction across read boundaries without retaining raw output."""
    def __init__(self, values):
        self.values = sorted({value.encode() for value in values if value}, key=len, reverse=True)
        self.pending = b""

    def feed(self, chunk, final=False):
        self.pending += chunk
        boundary = len(self.pending) if final else max(0, len(self.pending) - max(map(len, self.values), default=1))
        output = bytearray()
        position = 0
        while position < boundary:
            match = next((value for value in self.values if self.pending.startswith(value, position)), None)
            if match:
                output.extend(b"[REDACTED]")
                position += len(match)
            else:
                output.append(self.pending[position])
                position += 1
        self.pending = self.pending[position:]
        return bytes(output)


@contextlib.contextmanager
def concurrency_gate(root, name, count, owner=None, wait=3600):
    directory = private_path(root / name, directory=True, create=True)
    descriptors = []
    held = None
    receipt = None
    permit = {"complete": False}
    deadline = time.monotonic() + wait
    try:
        for index in range(count):
            path = private_path(directory / str(index), create=True)
            descriptors.append(os.open(path, os.O_RDWR | os.O_NOFOLLOW))
        while held is None:
            for index, fd in enumerate(descriptors):
                try:
                    fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                except BlockingIOError:
                    continue
                candidate = directory / f"{index}.json"
                if owner and candidate.exists():
                    private_path(candidate)
                    if json.loads(candidate.read_text()).get("state") != "free":
                        # An unlocked permit can still have live descendants after
                        # supervisor loss. Its receipt, not a PID timeout, fences reuse.
                        fcntl.flock(fd, fcntl.LOCK_UN)
                        continue
                held = fd
                receipt = candidate
                if owner:
                    atomic_json(receipt, {"state": "active", "supervisor": process_identity(),
                                          "lease_id": owner["lease_id"], "generation": owner["generation"]})
                break
            if held is None:
                if time.monotonic() >= deadline:
                    raise SlotError("heavy capacity is occupied or quarantined; bounded wait expired")
                time.sleep(min(0.05, max(0, deadline - time.monotonic())))
        yield permit
    finally:
        if owner and held is not None:
            atomic_json(receipt, {"state": "free" if permit["complete"] else "quarantined",
                                  "lease_id": owner["lease_id"], "generation": owner["generation"]})
        for fd in descriptors:
            os.close(fd)


def heavy_limit():
    memory = os.sysconf("SC_PHYS_PAGES") * os.sysconf("SC_PAGE_SIZE")
    return max(1, min(2, (os.cpu_count() or 1) // 4, memory // (8 * 1024 ** 3)))


def is_heavy_command(command):
    if command[:2] in (["mix", "check"], ["mix", "check.deep"], ["mix", "dialyzer"], ["mix", "compile"]):
        return True
    if command[:2] != ["mix", "test"]:
        return False
    focused = "--only" in command or any(
        value.startswith("test/") or ".exs" in value for value in command[2:])
    return not focused


def signal_owned_descendants(supervisor, number):
    """Signal identified descendants through pidfds, never a recycled PID/group."""
    if not process_alive(supervisor):
        raise SlotError("supervisor identity changed; no process signalled")
    failed = False
    for pid in descendants(process_metadata(), supervisor["pid"]) - {supervisor["pid"]}:
        fd = None
        try:
            identity = process_identity(pid)
            fd = os.pidfd_open(pid)
            if (process_alive(identity)
                    and pid in descendants(process_metadata(), supervisor["pid"])):
                signal.pidfd_send_signal(fd, number)
        except (ProcessLookupError, SlotError):
            continue
        except OSError:
            failed = True
        finally:
            if fd is not None:
                os.close(fd)
    if failed:
        raise SlotError("some owned descendants could not be signalled; preserve resources")


def write_all(fd, data):
    remaining = memoryview(data)
    while remaining:
        count = os.write(fd, remaining)
        if count <= 0:
            raise OSError("output write made no progress")
        remaining = remaining[count:]


def managed_run(pool, lease, command, env, *, http=False, auto_release=True, redact=(), heavy=False):
    """Supervise through all descendants; abnormal supervisor loss stays quarantined."""
    if not command:
        raise SlotError("managed run requires a command")
    if (not hasattr(os, "pidfd_open") or not hasattr(signal, "pidfd_send_signal")
            or ctypes.CDLL(None, use_errno=True).prctl(36, 1, 0, 0, 0) != 0):
        raise SlotError("Linux child subreaping and pidfd signalling are required")
    descriptor = None
    try:
        descriptor = os.pidfd_open(os.getpid())
        signal.pidfd_send_signal(descriptor, 0)
    except OSError:
        raise SlotError("Linux kernel pidfd signalling is unavailable; no managed child launched") from None
    finally:
        if descriptor is not None:
            os.close(descriptor)
    gate = concurrency_gate(pool.root, "heavy", heavy_limit(), owner=lease) if heavy else contextlib.nullcontext()
    with gate as permit:
        # No child exists yet. Only an attempted Popen with uncertain outcome can
        # change this; proven pre-launch failures must not consume heavy capacity.
        if permit is not None:
            permit["complete"] = True
        try:
            reservation = reserve_port(lease["port"])
        except SlotError:
            pool.retain(lease["lease_id"], lease["generation"], lease["worktree"],
                        "HTTP port occupied before launch; no child started; retry or release exact lease")
            raise
        job = None
        read_fd = write_fd = -1
        prior_handlers = {}
        child_possible = False
        child = None
        try:
            job = pool.begin_job(lease["lease_id"], lease["generation"], lease["worktree"],
                                 profile="dev" if http else "test")
            runs = private_path(pool.root / "runs", directory=True, create=True)
            directory = private_path(runs / job, directory=True, create=True)
            output = private_path(directory / "output.log", create=True)
            env = env.copy()
            env.update(DEVCORE_SLOT_LEASE=lease["lease_id"], DEVCORE_SLOT_GENERATION=lease["generation"],
                       DEVCORE_SLOT_JOB=job, DEVCORE_SLOT_PROJECT="new_you", NEW_YOU_PORT=str(lease["port"]),
                       DEVCORE_SLOT_WORKTREE=lease["worktree"])
            read_fd, write_fd = os.pipe()
            launcher = "import os,sys,signal;[signal.signal(n,signal.SIG_DFL) for n in (signal.SIGINT,signal.SIGTERM,signal.SIGHUP)];fd=int(sys.argv[1]);go=os.read(fd,1);os.close(fd);" \
                       "sys.exit(125) if go!=b'1' else None;os.execvpe(sys.argv[2],sys.argv[2:],os.environ)"
            pending = []
            for number in (signal.SIGHUP, signal.SIGTERM, signal.SIGINT):
                prior_handlers[number] = signal.getsignal(number)
                signal.signal(number, signal.SIG_IGN if number == signal.SIGHUP else
                              lambda received, _frame: pending.append(received))
            child_possible = True
            if permit is not None:
                permit["complete"] = False
            try:
                child = subprocess.Popen([sys.executable, "-c", launcher, str(read_fd), *command],
                                         cwd=lease["worktree"], env=env, start_new_session=True,
                                         pass_fds=(read_fd,), stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
            except OSError:
                # Popen reaps a failed exec before reporting its OSError. We use
                # no preexec_fn; an interrupted/unknown launch remains uncertain.
                child_possible = False
                if permit is not None:
                    permit["complete"] = True
                raise
            pool.set_session(lease["lease_id"], lease["generation"], lease["worktree"], job, child.pid)
            supervisor = process_identity()
            def forward_stop(number, _frame):
                signal_owned_descendants(supervisor, number)
            for number in (signal.SIGINT, signal.SIGTERM):
                signal.signal(number, forward_stop)
            if http:
                reservation.close()
            os.write(write_fd, b"1")
            os.close(write_fd)
            write_fd = -1
            os.close(read_fd)
            read_fd = -1
            for number in pending:
                forward_stop(number, None)
            import selectors
            selector = selectors.DefaultSelector()
            selector.register(child.stdout, selectors.EVENT_READ)
            redactor = Redactor(redact)
            result = None
            output_open = True
            has_children = True
            next_listener_check = 0
            with output.open("wb") as log:
                while has_children or output_open:
                    now = time.monotonic()
                    if http and now >= next_listener_check:
                        next_listener_check = now + 0.25
                        if listener_ownership(lease["port"], os.getpid()) == "foreign":
                            pool.quarantine(lease["lease_id"], lease["generation"], lease["worktree"],
                                            "foreign listener during HTTP handoff; preserve all processes")
                            http = False
                    for event, _ in selector.select(0.05):
                        chunk = os.read(event.fileobj.fileno(), 65536)
                        data = redactor.feed(chunk, final=not chunk)
                        log.write(data)
                        log.flush()
                        try:
                            write_all(sys.stdout.fileno(), data)
                        except (OSError, AttributeError):
                            pass
                        if not chunk:
                            selector.unregister(child.stdout)
                            output_open = False
                    while True:
                        try:
                            pid, status = os.waitpid(-1, os.WNOHANG)
                        except ChildProcessError:
                            has_children = False
                            break
                        if pid == 0:
                            break
                        if pid == child.pid:
                            result = os.waitstatus_to_exitcode(status)
                            child.returncode = result
                log.flush()
                os.fsync(log.fileno())
            if permit is not None:
                permit["complete"] = True
            selector.close()
            child.stdout.close()
            result = 125 if result is None else result
            atomic_json(directory / "result.json", {"lease_id": lease["lease_id"], "generation": lease["generation"],
                        "job": job, "exit": result, "children_reaped": True})
            pool.end_job(lease["lease_id"], lease["generation"], lease["worktree"], job, result)
            if result == 0 and auto_release:
                pool.release(lease["lease_id"], lease["generation"], lease["worktree"])
            return result if result >= 0 else 128 - result
        except BaseException:
            if job is not None:
                if not child_possible:
                    pool.end_job(lease["lease_id"], lease["generation"], lease["worktree"], job, 125)
                else:
                    pool.quarantine(lease["lease_id"], lease["generation"], lease["worktree"],
                                    "supervision interrupted; preserve all descendants and resources")
            raise
        finally:
            reservation.close()
            for fd in (read_fd, write_fd):
                if fd >= 0:
                    os.close(fd)
            for number, handler in prior_handlers.items():
                signal.signal(number, handler)

class SlotContext:
    """Validate opt-in consumer configuration and build immutable env snapshots."""
    def __init__(self, tool, project_file, global_file, secret_file, central):
        self.tool = str(Path(tool).resolve(strict=True))
        self.worktree = str(Path.cwd().resolve())
        self.project_file = str(Path(project_file).resolve(strict=True))
        self.global_file = str(private_path(global_file).resolve())
        self.secret_file = str(private_path(secret_file).resolve())
        self.central = private_path(central, directory=True)
        self.project = parse_pairs(self.project_file)
        self.global_config = parse_pairs(self.global_file)
        required = {"PROJECT_KEY": "new_you", "DEV_DB_ROLE": "new_you_dev", "DEV_DB_NAME": "new_you_dev",
                    "TEST_DB_ROLE": "new_you_test", "TEST_DB_NAME": "new_you_test",
                    "TEST_ROLE_CREATEDB": "no", "USE_REDIS": "no",
                    "DEV_SECRET_KEY": "NEW_YOU_DEV_DB_PASSWORD", "TEST_SECRET_KEY": "NEW_YOU_TEST_DB_PASSWORD"}
        if any(self.project.get(key) != value for key, value in required.items()):
            raise SlotError("managed slots require the unchanged NewYou legacy allocation and NOCREATEDB")
        for key, expected in (("PG_DEV_HOST", "127.0.0.1"), ("PG_DEV_PORT", "55432"),
                              ("PG_TEST_HOST", "127.0.0.1"), ("PG_TEST_PORT", "55433"),
                              ("PG_TEST_CONTAINER", "dev-core-postgres-test-1"), ("PG_ADMIN_ROLE", "devcore_admin")):
            if self.global_config.get(key, expected) != expected:
                raise SlotError("workstation endpoints differ from the approved slot contract")
        self.contract = newyou_contract()
        if self.project.get("SLOT_POOL"):
            declared = Path(self.project["SLOT_POOL"])
            if json.loads(declared.read_text()) != self.contract:
                raise SlotError("SLOT_POOL declaration differs from the supported manifest")
        slots = private_path(self.central / "slots", directory=True, create=True)
        self.secrets = SlotSecrets(self.secret_file)
        self.pool = Pool(slots / "new_you", self.contract, Postgres(self.contract, self.secrets.create))

    def require_opt_in(self):
        if not self.project.get("SLOT_POOL"):
            raise SlotError("consumer has not opted in with SLOT_POOL; read the NewYou integration contract")

    def environment(self, lease, profile):
        if os.environ.get("MIX_TEST_PARTITION"):
            raise SlotError("MIX_TEST_PARTITION is unsupported for managed TEST")
        root = Path(self.worktree)
        local_paths = {}
        for variable, name in (("MIX_BUILD_PATH", "_build"), ("MIX_DEPS_PATH", "deps")):
            chosen = Path(os.environ.get(variable, str(root / name)))
            if not chosen.is_absolute():
                chosen = root / chosen
            if not chosen.resolve().is_relative_to(root):
                raise SlotError("mutable build and dependency paths must stay inside this canonical worktree")
            local_paths[variable] = str(chosen)
        snapshots = private_path(self.pool.root / "snapshots", directory=True, create=True)
        snapshot = private_path(snapshots / uuid.uuid4().hex, directory=True, create=True)
        try:
            return self.environment_snapshot(lease, profile, local_paths, snapshot)
        finally:
            shutil.rmtree(snapshot)

    def environment_snapshot(self, lease, profile, local_paths, snapshot):
        project = self.project.copy()
        project.pop("SLOT_POOL", None)
        project.update(TEST_DB_NAME=lease["database"], TEST_DB_ROLE=lease["role"],
                       TEST_SECRET_KEY=self.secrets.key(lease))
        # Resolve all tracked inputs before changing cwd for the existing renderer.
        if project.get("SUPPLEMENTAL_SECRETS"):
            project["SUPPLEMENTAL_SECRETS"] = str(Path(project["SUPPLEMENTAL_SECRETS"]).resolve(strict=True))
        rows = []
        rendered = []
        for index, raw in enumerate(Path(project.get("RENDER_MAP", ".devcore/render-map.tsv")).read_text().splitlines()):
            if not raw.strip() or raw.lstrip().startswith("#"):
                continue
            parts = raw.split("\t")
            if len(parts) not in (3, 4) or parts[0] not in ("dev", "test", "all"):
                raise SlotError("invalid managed render map")
            template = str(Path(parts[1]).resolve(strict=True))
            target = snapshot / f"env-{index}"
            rows.append("\t".join([parts[0], template, str(target), parts[3] if len(parts) == 4 else ""]))
            rendered.append((parts[0], target))
        if not any(kind == "test" for kind, _ in rendered):
            raise SlotError("managed run requires a TEST render profile")
        project["RENDER_MAP"] = str(snapshot / "render-map.tsv")
        atomic_text(snapshot / "project.conf", "".join(f"{key}={value}\n" for key, value in project.items()))
        atomic_text(snapshot / "render-map.tsv", "\n".join(rows) + "\n")
        renderer_env = os.environ.copy()
        for key in list(renderer_env):
            if key.startswith("DEVCORE_MUTATION_"):
                renderer_env.pop(key)
        renderer_env.update(DEVCORE_PROJECT_CONF=str(snapshot / "project.conf"),
                            DEVCORE_GLOBAL_CONF=self.global_file, DEVCORE_SECRETS_FILE=self.secret_file,
                            DEVCORE_CONFIG_DIR=str(self.central))
        result = subprocess.run([self.tool, "render"], cwd=snapshot, env=renderer_env,
                                capture_output=True, text=True, timeout=30)
        if result.returncode:
            raise SlotError("managed environment rendering failed; no worktree env files changed")
        env = os.environ.copy()
        for key in list(env):
            if (key in ("DATABASE_URL", "MIX_TEST_PARTITION") or key.startswith(("PG", "DEVCORE_SLOT_", "DEVCORE_MUTATION_", "TEST_DATABASE_", "DEV_DATABASE_"))):
                env.pop(key)
        for kind, target in rendered:
            if kind in ("all", "test", profile):
                for key, value in parse_pairs(target).items():
                    if key.startswith("export "):
                        key = key[7:].strip()
                    if kind == "test" and profile == "dev" and not key.startswith("TEST_DATABASE_"):
                        continue
                    if len(value) >= 2 and value[0] == value[-1] and value[0] in ("'", '"'):
                        value = value[1:-1]
                    env[key] = value
        # The existing renderer validated the entire supplemental map and values.
        # Runtime bindings also work without template tokens, as in legacy run.
        if project.get("SUPPLEMENTAL_SECRETS"):
            bindings = [tuple(part.strip() for part in raw.split("\t"))
                        for raw in Path(project["SUPPLEMENTAL_SECRETS"]).read_text().splitlines()
                        if raw.strip() and not raw.lstrip().startswith("#")]
            values = parse_pairs(self.secret_file)
            for _, variable, _ in bindings:
                env.pop(variable, None)
            for kind, variable, secret_key in bindings:
                if kind in ("all", profile):
                    env[variable] = values[secret_key]
        if profile == "test":
            for key in list(env):
                if key.startswith("DEV_DATABASE_"):
                    env.pop(key)
        binding_keys = {f"{kind}_DATABASE_{field}" for kind in ("DEV", "TEST")
                        for field in ("HOST", "PORT", "NAME", "USERNAME", "PASSWORD")}
        if any(key.startswith("PG") or "DATABASE_URL" in key or key == "DB_URL" or key.endswith("_DB_URL")
               or (key.startswith(("DEV_DATABASE_", "TEST_DATABASE_")) and key not in binding_keys)
               for key in env):
            raise SlotError("alternate database connection variables are unsupported in managed mode")
        env.update(MIX_ENV=profile, MIX_BUILD_PATH=local_paths["MIX_BUILD_PATH"], MIX_DEPS_PATH=local_paths["MIX_DEPS_PATH"],
                   DEVCORE_PROJECT_CONF=self.project_file, DEVCORE_GLOBAL_CONF=self.global_file,
                   DEVCORE_SECRETS_FILE=self.secret_file, DEVCORE_CONFIG_DIR=str(self.central))
        # Every job receives the TEST identity, including DEV jobs launching test children.
        expected = {"TEST_DATABASE_HOST": "127.0.0.1", "TEST_DATABASE_PORT": "55433",
                    "TEST_DATABASE_NAME": lease["database"], "TEST_DATABASE_USERNAME": lease["role"],
                    "TEST_DATABASE_PASSWORD": self.secrets.existing(lease)}
        if any(env.get(key) != value for key, value in expected.items()):
            raise SlotError("managed TEST template does not propagate the exact allocation")
        return env

    def redactions(self, lease):
        values = parse_pairs(self.secret_file)
        keys = {self.project.get("DEV_SECRET_KEY"), self.project.get("TEST_SECRET_KEY"), self.secrets.key(lease)}
        supplemental = self.project.get("SUPPLEMENTAL_SECRETS")
        if supplemental:
            for raw in Path(supplemental).read_text().splitlines():
                if raw.strip() and not raw.lstrip().startswith("#"):
                    keys.add(raw.split("\t")[2].strip())
        return [values[key] for key in keys if key in values]


def verify_job(pool, lease_id, generation, job_id, worktree):
    with pool.registry() as state:
        row = pool.owned(state, lease_id, generation, worktree)
        job = row["jobs"].get(job_id)
        if row["state"] != "in_use" or not job or not process_alive(job["supervisor"]):
            raise SlotError("managed allocation is not owned by a live job")
        if os.getpid() not in descendants(process_metadata(), job["supervisor"]["pid"]):
            raise SlotError("allocation verifier is outside the managed child tree")
        if job.get("profile") not in ("dev", "test"):
            raise SlotError("registered job profile is unavailable; preserve the allocation")
        result = {key: row[key] for key in ("project", "slot", "port", "lease_id", "generation", "worktree", "database", "role", "test_host", "test_port")}
        result["profile"] = job["profile"]
        return result


def slot_cli(arguments):
    if arguments[:2] == ["run", "all"]:
        raise SlotError("managed mode supports only dev and test; run all is unavailable; no resources acquired")
    parser = argparse.ArgumentParser(prog="devcore-project slots")
    sub = parser.add_subparsers(dest="action", required=True)
    sub.add_parser("manifest", help="print the bounded activation/cleanup contract and digest")
    enable = sub.add_parser("enable", help="record already-approved exact manifest authorization")
    enable.add_argument("--manifest", required=True)
    enable.add_argument("--approval-ref", required=True)
    sub.add_parser("disable", help="stop new acquisition without touching active leases")
    sub.add_parser("status", help="print non-secret allocated slots as JSON")
    acquire = sub.add_parser("acquire", help="prepare a fresh generation for this worktree")
    acquire.add_argument("--wait", type=float, default=0)
    recovery = sub.add_parser("recover", help="quarantine interruptions or retry one previously guarded cleanup")
    recovery.add_argument("--lease")
    recovery.add_argument("--generation")
    for action in ("release", "retain", "verify"):
        option = sub.add_parser(action)
        option.add_argument("--lease", required=True)
        option.add_argument("--generation", required=True)
        if action == "verify":
            option.add_argument("--job", required=True)
    run = sub.add_parser("run", help="automatically lease, supervise, then release or retain")
    run.add_argument("profile", choices=("dev", "test"))
    run.add_argument("--lease")
    run.add_argument("--generation")
    run.add_argument("--wait", type=float, default=0)
    run.add_argument("--heavy", action="store_true")
    run.add_argument("--retain", action="store_true")
    run.add_argument("command", nargs=argparse.REMAINDER)
    args = parser.parse_args(arguments)
    context = SlotContext(*sys.argv[1:6])
    pool = context.pool
    if args.action == "manifest":
        print(json.dumps({"manifest": pool.manifest(), "sha256": pool.manifest_digest(),
                          "port_conflicts": [port for port in range(4221, 4241) if not port_available(port)],
                          "approval_text": GitHubApproval.text(pool.manifest_digest()),
                          "heavy_limit": heavy_limit(), "logical_cpus": os.cpu_count(),
                          "memory_bytes": os.sysconf("SC_PHYS_PAGES") * os.sysconf("SC_PAGE_SIZE")}, sort_keys=True))
    elif args.action == "enable":
        context.require_opt_in()
        pool.enable(args.manifest, args.approval_ref)
        print(json.dumps({"authorized_manifest": pool.manifest_digest()}))
    elif args.action == "disable":
        pool.disable()
        print(json.dumps({"acquisition_enabled": False}))
    elif args.action in ("status", "recover"):
        if args.action == "recover" and (args.lease or args.generation):
            if not args.lease or not args.generation:
                raise SlotError("cleanup recovery requires both exact lease and generation")
            pool.release(args.lease, args.generation, context.worktree, retry=True)
        print(json.dumps(pool.recover() if args.action == "recover" else pool.status(), sort_keys=True))
    elif args.action == "acquire":
        context.require_opt_in()
        if not 0 <= args.wait <= 3600:
            raise SlotError("wait must be bounded between 0 and 3600 seconds")
        print(json.dumps(pool.acquire(context.worktree, wait=args.wait), sort_keys=True))
    elif args.action in ("release", "retain"):
        getattr(pool, args.action)(args.lease, args.generation, context.worktree)
        print(json.dumps({"lease_id": args.lease, "operation": args.action}))
    elif args.action == "verify":
        print(json.dumps(verify_job(pool, args.lease, args.generation, args.job, context.worktree), sort_keys=True))
    elif args.action == "run":
        context.require_opt_in()
        command = args.command[1:] if args.command[:1] == ["--"] else args.command
        if not command or not 0 <= args.wait <= 3600 or bool(args.lease) != bool(args.generation):
            raise SlotError("run needs a command, bounded wait, and both lease/generation if reusing a session")
        # A nested compatible run keeps the same job and never acquires another database.
        required_markers = ("DEVCORE_SLOT_JOB", "DEVCORE_SLOT_LEASE", "DEVCORE_SLOT_GENERATION",
                            "DEVCORE_SLOT_PROJECT", "DEVCORE_SLOT_WORKTREE")
        if (any(key.startswith("DEVCORE_SLOT_") for key in os.environ)
                and not all(os.environ.get(key) for key in required_markers)):
            raise SlotError("partial managed job identity; no legacy fallback or new acquisition")
        nested = os.environ.get("DEVCORE_SLOT_JOB")
        if nested and not args.lease:
            row = verify_job(pool, os.environ.get("DEVCORE_SLOT_LEASE"), os.environ.get("DEVCORE_SLOT_GENERATION"), nested, context.worktree)
            if args.profile == "dev" and row["profile"] != "dev":
                raise SlotError("a TEST job cannot become a shared DEV job")
            env = context.environment(row, args.profile)
            env.update(DEVCORE_SLOT_LEASE=row["lease_id"], DEVCORE_SLOT_GENERATION=row["generation"],
                       DEVCORE_SLOT_JOB=nested, DEVCORE_SLOT_PROJECT=row["project"],
                       NEW_YOU_PORT=str(row["port"]), DEVCORE_SLOT_WORKTREE=row["worktree"])
            os.execvpe(command[0], command, env)
        if args.lease:
            with pool.registry() as state:
                lease = copy.deepcopy(pool.owned(state, args.lease, args.generation, context.worktree))
        else:
            lease = pool.acquire(context.worktree, wait=args.wait)
        try:
            env = context.environment(lease, args.profile)
            code = managed_run(pool, lease, command, env, http=args.profile == "dev",
                               auto_release=not args.lease and not args.retain,
                               redact=context.redactions(lease), heavy=args.heavy or is_heavy_command(command))
            if args.retain and code == 0:
                pool.retain(lease["lease_id"], lease["generation"], context.worktree)
            return code
        except (SlotError, OSError, ValueError, KeyError, subprocess.SubprocessError, KeyboardInterrupt):
            # Never turn failed preparation into a ready resource.
            with pool.registry() as state:
                row = pool.owned(state, lease["lease_id"], lease["generation"], context.worktree)
                if row["state"] == "ready":
                    row["state"] = "retained"
            raise
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(slot_cli(sys.argv[6:]))
    except KeyboardInterrupt:
        raise SystemExit("ERROR: managed slot wait cancelled; resources preserved") from None
    except SlotError as error:
        raise SystemExit("ERROR: " + str(error)) from None
    except (OSError, ValueError, KeyError, subprocess.SubprocessError):
        raise SystemExit("ERROR: managed slot operation failed; preserve resources and inspect non-secret status") from None
# DEVCORE_SLOTS_PYTHON_END
DEVCORE_SLOTS_PYTHON
}

main() {
  need_cmd python3
  local cmd="${1-help}"; shift || true
  case "$cmd" in
    install|plan|activate|doctor|render|rotate|run|slots)
      validate_state_paths
      ;;
  esac
  case "$cmd" in
    install|activate|rotate|render)
      if [[ -n "${DEVCORE_MUTATION_LOCK_FDS:-}" ]]; then
        validate_inherited_mutation_lock
      else
        acquire_mutation_lock "$cmd" "$@"
      fi
      ;;
  esac
  case "$cmd" in
    slots)
      require_no_xtrace
      slots_main "$@"
      ;;
    help|-h|--help) usage ;;
    version|--version) printf '%s %s\n' "$PROGRAM" "$VERSION" ;;
    install)
      write_global_defaults
      pass "dev-core config initialized at $CENTRAL_DIR"
      ;;
    init)
      cmd_init "$@"
      ;;
    plan|activate|doctor|render|rotate|run)
      case "$cmd" in
        activate|render|rotate) write_global_defaults ;;
      esac
      load_global
      load_project
      validate_project
      check_render_contract
      case "$cmd" in
        plan)
          print_plan
          require_supplemental_secrets
          ;;
        activate)
          need_cmd docker
          require_no_xtrace
          preflight_operational_contract
          ensure_secret_pair
          provision_all
          render_all
          doctor_all
          pass "project '$PROJECT_KEY' activated"
          ;;
        doctor)
          need_cmd docker
          require_secret_pair
          require_supplemental_secrets
          doctor_all
          ;;
        render)
          require_no_xtrace
          require_secret_pair
          require_supplemental_secrets
          render_all
          ;;
        rotate)
          need_cmd docker
          require_no_xtrace
          require_secret_pair
          rotate_all
          ;;
        run)
          if [[ -n "$SLOT_POOL" || -n "${!DEVCORE_SLOT_*}" ]]; then
            require_no_xtrace
            slots_main run "$@"
          else
            run_profile "$@"
          fi
          ;;
      esac
      ;;
    *) usage; die "unknown command: $cmd" ;;
  esac
}

main "$@"
